---
// Fonts are served from this site: no third-party request, and they work offline.
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/saira-condensed/600.css";
import "@fontsource/saira-condensed/700.css";
import sairaBold from "@fontsource/saira-condensed/files/saira-condensed-latin-700-normal.woff2?url";
import sairaSemi from "@fontsource/saira-condensed/files/saira-condensed-latin-600-normal.woff2?url";
import plexSans from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import "../styles/global.css";
import { isTranslatedPage, localLink } from "../lib/paths";
import { HTML_LANG, LOCALES, LOCALE_NAMES, localeOf, localePath, unlocalePath } from "../i18n/locales";
import { translator } from "../i18n/t";
import { SHELL } from "../i18n/strings/shell";
import { SITE, absolute, reportUrl } from "../lib/site";
import { amazonTags } from "../lib/shop";

const link = localLink(Astro.currentLocale);
const locale = localeOf(Astro.currentLocale);
const t = translator(SHELL, locale);

type Section =
  | "library"
  | "start"
  | "boards"
  | "wire"
  | "detective"
  | "bench"
  | "errors"
  | "tools"
  | "flames"
  | "about"
  | "report"
  | "search"
  | "none";

interface Props {
  title?: string;
  /** One or two sentences for search results and link previews */
  description?: string;
  current: Section;
  /** Site path of a 1200x630 preview image */
  image?: string;
  /** Structured data for search engines */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results, e.g. the 404 page */
  noindex?: boolean;
}

const { title, description = t("description"), current, image = "/og.png", jsonLd, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${t("tagline")}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sitePath = base && Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const canonical = absolute(sitePath, Astro.site);

// Languages: a translated page links to its other versions (hreflang, the
// language menu); an English-only page offers each language's home page.
const { path: englishPath } = unlocalePath(sitePath);
const translated = isTranslatedPage(englishPath);
const versions = LOCALES.map((l) => ({
  locale: l,
  name: LOCALE_NAMES[l],
  href: `${base}${localePath(translated ? englishPath : "/", l)}`,
  url: absolute(localePath(englishPath, l), Astro.site),
}));
const englishUrl = `${base}${englishPath}`;

// Breadcrumbs for search results, from the URL: a page inside a section
// (a project, a board, an error, a tool) sits under that section.
const SECTION_OF: Record<string, [string, string]> = {
  projects: [t("navLibrary"), "/"],
  boards: [t("navBoards"), "/boards/"],
  errors: [t("navErrors"), "/errors/"],
  tools: [t("navTools"), "/tools/"],
};
const segments = englishPath.split("/").filter(Boolean);
const section = segments.length >= 2 ? SECTION_OF[segments[0]] : undefined;
const crumbs: [string, string][] =
  section && title
    ? [[SITE.name, "/"], ...(section[1] === "/" ? [] : [section]), [title, englishPath]]
    : [];
const breadcrumbLd = crumbs.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map(([name, path], i) => ({
        "@type": "ListItem",
        position: i + 1,
        name,
        item: absolute(translated ? localePath(path, locale) : path, Astro.site),
      })),
    }
  : undefined;
const imageUrl = absolute(image, Astro.site);
const correctionUrl = noindex || current === "report" ? "" : reportUrl("correction", { page: canonical });

// Pages that live under another tab: that tab is marked as the current section.
const PARENT: Partial<Record<Section, Section>> = { detective: "tools", flames: "errors" };
const navSection = PARENT[current] ?? current;
const NAV: [Exclude<Section, "none" | "about">, string, string][] = [
  ["library", "/", t("navLibrary")],
  ["start", "/start/", t("navGuide")],
  ["boards", "/boards/", t("navBoards")],
  ["wire", "/wire/", t("navWire")],
  ["bench", "/bench/", t("navBench")],
  ["errors", "/errors/", t("navErrors")],
  ["tools", "/tools/", t("navTools")],
];
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-locale={locale} data-translated={translated ? "" : undefined} data-amazon-tags={amazonTags() === "{}" ? undefined : amazonTags()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      translated &&
        !noindex && [
          ...versions.map((v) => <link rel="alternate" hreflang={HTML_LANG[v.locale]} href={v.url} />),
          <link rel="alternate" hreflang="x-default" href={versions[0].url} />,
        ]
    }
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={HTML_LANG[locale].replace("-", "_")} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={link("/favicon.svg")} />
    <link rel="apple-touch-icon" href={link("/icons/apple-touch-icon.png")} />
    <link rel="author" href={SITE.author.url} />
    <link rel="manifest" href={link("/manifest.webmanifest")} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: what's new`} href={link("/rss.xml")} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {
      import.meta.env.PROD && SITE.ahrefsKey && (
        <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key={SITE.ahrefsKey} async />
      )
    }

    <script is:inline>
      // Apply the saved theme before first paint so the page does not flash.
      try {
        const t = localStorage.getItem("bench.theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    {
      [sairaBold, sairaSemi, plexSans].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#main">{t("skip")}</a>
    <div class="wrap">
      <header class="top">
        <a class="brand" href={link("/")}>ESP32 <span>Bench</span></a>
        <div class="rev" set:html={t("rev")} />
        <div class="tools">
          <form class="hsearch" id="hsearch" role="search" action={link("/search/")} method="get">
            <label class="sr" for="hsearch-q">{t("searchLabel")}</label>
            <input
              id="hsearch-q"
              name="q"
              type="search"
              placeholder={t("searchPlaceholder")}
              autocomplete="off"
              spellcheck="false"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="hsearch-list"
              aria-expanded="false"
            />
            <button class="btn sm hsearch-go" type="submit" aria-label={t("searchButton")}>
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </button>
            <ul class="hsearch-list" id="hsearch-list" role="listbox" aria-label={t("quickResults")} hidden></ul>
          </form>
          <button class="btn sm" type="button" id="install-app" hidden>{t("install")}</button>
          <button class="btn sm" type="button" id="theme">{t("theme", { theme: t("themeAuto") })}</button>
          <details class="langmenu">
            <summary class="btn sm" aria-label={t("language")}>{locale === "en" ? "EN" : locale.toUpperCase()}</summary>
            <ul>
              {
                versions.map((v) => (
                  <li>
                    <a href={v.href} hreflang={HTML_LANG[v.locale]} lang={HTML_LANG[v.locale]} data-locale-link={v.locale} aria-current={v.locale === locale ? "true" : undefined}>
                      {v.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
        <nav class="tabs" aria-label={t("sections")}>
          {
            NAV.map(([id, href, label]) => (
              <a href={link(href)} aria-current={current === id ? "page" : navSection === id ? "true" : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </header>
      <p class="offline-note" id="offline-note" role="status" hidden>{t("offline")}</p>
      {
        locale !== "en" && (
          <p class="mtnote" lang={HTML_LANG[locale]}>
            {t("machine")} <a href={englishUrl} hreflang="en" lang="en" data-locale-link="en">{t("original")}</a>
          </p>
        )
      }
      <p class="langoffer" id="langoffer" hidden>
        <span></span> <a class="btn sm" href="#"></a> <button class="btn sm" type="button"></button>
      </p>
      <main id="main">
        <slot />
      </main>
      <footer>
        <nav class="footnav" aria-label={t("footSite")}>
          <a href={link("/about/")} aria-current={current === "about" ? "page" : undefined}>{t("footAbout")}</a>
          <a href={link("/changes/")}>{t("footNew")}</a>
          <a href={link("/report/?kind=message")} aria-current={current === "report" ? "page" : undefined}>{t("footContact")}</a>
          <a href={link("/rss.xml")}>{t("footRss")}</a>
          {SITE.repo && <a href={SITE.repo}>{t("footSource")}</a>}
          {correctionUrl && <a href={correctionUrl}>{t("footMistake")}</a>}
        </nav>
        <p
          set:html={t("footMade", {
            site: SITE.name,
            author: `<a href="${SITE.author.url}" rel="author">${SITE.author.name}</a>`,
            about: `<a href="${link("/about/#affiliate")}">${t("footAbout")}</a>`,
          })}
        />
      </footer>
    </div>
  </body>
</html>

<script>
  import "../scripts/shell.ts";
  import "../scripts/search-ui.ts";
  import "../scripts/scroll-rows.ts";
  import "../scripts/sync.ts";
  import "../scripts/amazon-region.ts";
  import "../scripts/offline.ts";
</script>
