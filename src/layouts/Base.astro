---
// Fonts are served from this site: no third-party request, and they work offline.
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/saira-condensed/600.css";
import "@fontsource/saira-condensed/700.css";
import sairaBold from "@fontsource/saira-condensed/files/saira-condensed-latin-700-normal.woff2?url";
import sairaSemi from "@fontsource/saira-condensed/files/saira-condensed-latin-600-normal.woff2?url";
import plexSans from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import "../styles/global.css";
import { link } from "../lib/paths";
import { SITE, absolute, reportUrl } from "../lib/site";
import { amazonTags } from "../lib/shop";

type Section =
  | "library"
  | "start"
  | "boards"
  | "wire"
  | "detective"
  | "bench"
  | "errors"
  | "tools"
  | "flames"
  | "about"
  | "report"
  | "search"
  | "none";

interface Props {
  title?: string;
  /** One or two sentences for search results and link previews */
  description?: string;
  current: Section;
  /** Site path of a 1200x630 preview image */
  image?: string;
  /** Structured data for search engines */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results, e.g. the 404 page */
  noindex?: boolean;
}

const { title, description = SITE.description, current, image = "/og.png", jsonLd, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sitePath = base && Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const canonical = absolute(sitePath, Astro.site);
const imageUrl = absolute(image, Astro.site);
const correctionUrl = noindex || current === "report" ? "" : reportUrl("correction", { page: canonical });

// Pages that live under another tab: that tab is marked as the current section.
const PARENT: Partial<Record<Section, Section>> = { detective: "tools", flames: "errors" };
const navSection = PARENT[current] ?? current;
const NAV: [Exclude<Section, "none" | "about">, string, string][] = [
  ["library", "/", "Library"],
  ["start", "/start/", "Guide"],
  ["boards", "/boards/", "Boards"],
  ["wire", "/wire/", "Wire"],
  ["bench", "/bench/", "Bench"],
  ["errors", "/errors/", "Errors"],
  ["tools", "/tools/", "Tools"],
];
---

<!doctype html>
<html lang="en" data-amazon-tags={amazonTags() === "{}" ? undefined : amazonTags()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={link("/favicon.svg")} />
    <link rel="apple-touch-icon" href={link("/icons/apple-touch-icon.png")} />
    <link rel="author" href={SITE.author.url} />
    <link rel="manifest" href={link("/manifest.webmanifest")} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: what's new`} href={link("/rss.xml")} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      import.meta.env.PROD && SITE.ahrefsKey && (
        <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key={SITE.ahrefsKey} async />
      )
    }

    <script is:inline>
      // Apply the saved theme before first paint so the page does not flash.
      try {
        const t = localStorage.getItem("bench.theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    {
      [sairaBold, sairaSemi, plexSans].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="top">
        <a class="brand" href={link("/")}>ESP32 <span>Bench</span></a>
        <div class="rev">Boards: ESP32, S2, S3, C3, C6<br />Flash and monitor: Web Serial</div>
        <div class="tools">
          <form class="hsearch" id="hsearch" role="search" action={link("/search/")} method="get">
            <label class="sr" for="hsearch-q">Search ESP32 Bench</label>
            <input
              id="hsearch-q"
              name="q"
              type="search"
              placeholder="Search  /"
              autocomplete="off"
              spellcheck="false"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="hsearch-list"
              aria-expanded="false"
            />
            <button class="btn sm hsearch-go" type="submit" aria-label="Search">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </button>
            <ul class="hsearch-list" id="hsearch-list" role="listbox" aria-label="Quick results" hidden></ul>
          </form>
          <button class="btn sm" type="button" id="install-app" hidden>Install app</button>
          <button class="btn sm" type="button" id="theme">Theme: auto</button>
        </div>
        <nav class="tabs" aria-label="Sections">
          {
            NAV.map(([id, href, label]) => (
              <a href={link(href)} aria-current={current === id ? "page" : navSection === id ? "true" : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </header>
      <p class="offline-note" id="offline-note" role="status" hidden>
        You are offline. Pages you have opened before still work. Flashing and buy links need a connection.
      </p>
      <main id="main">
        <slot />
      </main>
      <footer>
        <nav class="footnav" aria-label="Site">
          <a href={link("/about/")} aria-current={current === "about" ? "page" : undefined}>About</a>
          <a href={link("/changes/")}>What's new</a>
          <a href={link("/report/?kind=message")} aria-current={current === "report" ? "page" : undefined}>Contact</a>
          <a href={link("/rss.xml")}>RSS feed</a>
          {SITE.repo && <a href={SITE.repo}>Source code</a>}
          {correctionUrl && <a href={correctionUrl}>Report a mistake on this page</a>}
        </nav>
        <p>
          {SITE.name} is made by <a href={SITE.author.url} rel="author">{SITE.author.name}</a>. Pin numbers are GPIO numbers. Check your own board's pinout before powering anything. Some buy
          links earn a commission; see <a href={link("/about/#affiliate")}>About</a>.
        </p>
      </footer>
    </div>
  </body>
</html>

<script>
  import "../scripts/shell.ts";
  import "../scripts/search-ui.ts";
  import "../scripts/scroll-rows.ts";
  import "../scripts/sync.ts";
  import "../scripts/amazon-region.ts";
</script>
