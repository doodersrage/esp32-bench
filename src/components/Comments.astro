---
// Comments through GitHub Discussions (giscus). Loads only when scrolled near,
// follows the site's theme, and renders nothing until SITE.giscus.enabled is true.
import { SITE } from "../lib/site";
import { translator } from "../i18n/t";
import { localeOf } from "../i18n/locales";
import { PROJECT } from "../i18n/strings/project";

const g = SITE.giscus;
const t = translator(PROJECT, Astro.currentLocale);
// giscus's own language codes
const GISCUS_LANG = { en: "en", es: "es", de: "de", fr: "fr", "pt-br": "pt" } as const;
const lang = GISCUS_LANG[localeOf(Astro.currentLocale)];
const esc = (x: string) => x.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
---

{
  g.enabled && g.categoryId && (
    <section class="stack tight band" id="discuss">
      <h2>{t("discussion")}</h2>
      <p class="lede" set:html={t("discussionLede", { repo: `<a href="https://github.com/${esc(g.repo)}/discussions">${esc(g.repo)}</a>` })} />
      <div
        class="giscus-host"
        data-repo={g.repo}
        data-repo-id={g.repoId}
        data-category={g.category}
        data-category-id={g.categoryId}
        data-lang={lang}
      >
      </div>
    </section>
  )
}

<style>
  .giscus-host { min-height: 120px; }
  #discuss .lede a { color: var(--accent); }
</style>

<script>
  const host = document.querySelector<HTMLElement>(".giscus-host");

  // giscus theme names for the site's three theme settings.
  const theme = () => {
    const t = document.documentElement.dataset.theme;
    return t === "dark" ? "dark" : t === "light" ? "light" : "preferred_color_scheme";
  };

  function load(el: HTMLElement) {
    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.async = true;
    s.crossOrigin = "anonymous";
    const attrs: Record<string, string> = {
      "data-repo": el.dataset.repo ?? "",
      "data-repo-id": el.dataset.repoId ?? "",
      "data-category": el.dataset.category ?? "",
      "data-category-id": el.dataset.categoryId ?? "",
      "data-mapping": "pathname",
      "data-strict": "1",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "top",
      "data-theme": theme(),
      "data-lang": el.dataset.lang ?? "en",
      "data-loading": "lazy",
    };
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    el.append(s);
  }

  if (host) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          load(host);
        }
      },
      { rootMargin: "600px" },
    );
    io.observe(host);

    // Keep the comments in step with the site's theme switch.
    new MutationObserver(() => {
      const frame = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
      frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, "https://giscus.app");
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>
