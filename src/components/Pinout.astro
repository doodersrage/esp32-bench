---
import type { Board } from "../data/boards";

interface Props {
  board: Board;
  /** Pin labels to highlight, e.g. ["3V3", "GND", "21"] */
  pins?: string[];
  caption?: string;
}

const { board, pins = [], caption } = Astro.props;
const used = new Set(pins);

// Boards repeat power and ground pads. Light up only the first of each label
// so a project shows one connection per signal.
const shown = new Set<string>();
const light = (label: string) => {
  if (!used.has(label) || shown.has(label)) return false;
  shown.add(label);
  return true;
};
const rightOn = board.right.map(light);
const leftOn = board.left.map(light);

const rows = board.left.map((left, i) => ({
  left,
  right: board.right[i],
  leftOn: leftOn[i],
  rightOn: rightOn[i],
  row: i + 1,
}));
const silk = (label: string) => board.silk?.[label];
// Short boards such as the XIAO get a smaller shield so the figure stays in proportion.
const compact = rows.length < 12;
const label = pins.length
  ? `${board.name} pinout with pins used by this project highlighted: ${pins.join(", ")}`
  : `${board.name} pinout`;
---

{
  rows.length === 0 ? (
    <figure class="fig nohead">
      <p class="cap left">{board.noHeader ?? "No header layout on file for this board."}</p>
      {pins.length > 0 && <p class="cap left">GPIOs this project uses: {pins.filter((p) => /^\d+$/.test(p)).join(", ") || "none"}.</p>}
    </figure>
  ) : (
    <figure class="fig">
      <div class="board" role="img" aria-label={label}>
        <div class:list={["pcb", { compact }]} style={`grid-row:1 / span ${rows.length}`}>
          <div class="can"></div>
          <div class="silk">{board.short}</div>
          <div class="usb"></div>
        </div>
        {rows.map((r) => (
          <>
            <div class:list={["pinrow", "l", { on: r.leftOn }]} style={`grid-column:1;grid-row:${r.row}`}>
              <span>
                {silk(r.left) && <small>{silk(r.left)}</small>}
                {r.left}
              </span>
              <i></i>
            </div>
            <div class:list={["pinrow", "r", { on: r.rightOn }]} style={`grid-column:3;grid-row:${r.row}`}>
              <i></i>
              <span>
                {r.right}
                {silk(r.right) && <small>{silk(r.right)}</small>}
              </span>
            </div>
          </>
        ))}
      </div>
      <figcaption>
        {caption ??
          `${board.name}. USB connector at the bottom.${board.silk ? " Small labels are the silkscreen names; the numbers are GPIOs." : ""}`}
      </figcaption>
    </figure>
  )
}

<style>
  small {
    font-size: 0.62rem;
    color: var(--muted);
    margin: 0 4px;
    font-weight: 400;
  }
  .pcb.compact .can {
    height: 44px;
    width: 52px;
  }
  .pcb.compact .silk {
    font-size: 0.68rem;
  }
  .nohead {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
</style>
