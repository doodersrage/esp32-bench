---
import type { Board } from "../data/boards";

interface Props {
  board: Board;
  /** Pin labels to highlight, e.g. ["3V3", "GND", "21"] */
  pins?: string[];
  caption?: string;
}

const { board, pins = [], caption } = Astro.props;
const used = new Set(pins);

// Boards repeat power and ground pads. Light up only the first of each label
// so a project shows one connection per signal.
const shown = new Set<string>();
const light = (label: string) => {
  if (!used.has(label) || shown.has(label)) return false;
  shown.add(label);
  return true;
};
const rightOn = board.right.map(light);
const leftOn = board.left.map(light);

const rows = board.left.map((left, i) => ({
  left,
  right: board.right[i],
  leftOn: leftOn[i],
  rightOn: rightOn[i],
  row: i + 1,
}));
const label = pins.length
  ? `${board.name} pinout with pins used by this project highlighted: ${pins.join(", ")}`
  : `${board.name} pinout`;
---

<figure class="fig">
  <div class="board" role="img" aria-label={label}>
    <div class="pcb" style={`grid-row:1 / span ${rows.length}`}>
      <div class="can"></div>
      <div class="silk">{board.short}</div>
      <div class="usb"></div>
    </div>
    {
      rows.map((r) => (
        <>
          <div class:list={["pinrow", "l", { on: r.leftOn }]} style={`grid-column:1;grid-row:${r.row}`}>
            <span>{r.left}</span>
            <i></i>
          </div>
          <div class:list={["pinrow", "r", { on: r.rightOn }]} style={`grid-column:3;grid-row:${r.row}`}>
            <i></i>
            <span>{r.right}</span>
          </div>
        </>
      ))
    }
  </div>
  <figcaption>{caption ?? `${board.name}. USB connector at the bottom.`}</figcaption>
</figure>
