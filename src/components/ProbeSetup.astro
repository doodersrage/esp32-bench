---
// Sends Wi-Fi and the ProbeHarbor device key to a freshly flashed probe over
// USB, then watches its status lines until the first reading. The protocol and
// the wait logic follow ProbeHarbor's own /flash page.
---

<div class="flashbox" data-probe-setup>
  <p>
    The probe has no settings after a flash. Fill these in with the board still on USB. They go straight to the board
    and are not stored by this site.
  </p>
  <form class="setupform" data-setup-form>
    <label for="setup-ssid">
      Wi-Fi network name
      <input id="setup-ssid" name="ssid" required autocomplete="off" maxlength="32" />
      <span class="hint">2.4 GHz only.</span>
    </label>
    <label for="setup-password">
      Wi-Fi password
      <input id="setup-password" name="password" type="password" autocomplete="off" maxlength="64" />
    </label>
    <label for="setup-key" class="wide">
      ProbeHarbor device key
      <input id="setup-key" name="key" required autocomplete="off" maxlength="300" />
      <span class="hint">From Dashboard, Devices at probeharbor.dev.</span>
    </label>
    <fieldset class="wide">
      <legend>Extra inputs to read</legend>
      <label for="setup-leak"><input id="setup-leak" type="checkbox" name="extras" value="leak" /> Leak contact</label>
      <label for="setup-door"><input id="setup-door" type="checkbox" name="extras" value="door" /> Door switch</label>
      <label for="setup-battery"><input id="setup-battery" type="checkbox" name="extras" value="battery" /> Battery</label>
      <span class="hint">Only tick what is wired. An unwired pin reads as dry or open. Leak and battery are not hardware tested yet.</span>
    </fieldset>
    <div class="wide row">
      <button class="btn go" type="submit" data-setup-send>Send settings to the probe</button>
      <span class="setupstatus" data-setup-status role="status"></span>
    </div>
  </form>
  <pre class="code" data-setup-log hidden></pre>
</div>

<script>
  import "../scripts/probe-setup.ts";
</script>
