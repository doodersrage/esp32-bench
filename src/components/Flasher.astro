---
// Browser install button, the same ESP Web Tools setup ProbeHarbor uses on /flash.
// The manifest picks the right image for the connected chip family.
import { link } from "../lib/paths";

interface Props {
  manifest: string;
  version: string;
  /** Chip families the manifest has images for, for the caption */
  families?: string;
}

const { manifest, version, families = "ESP32, ESP32-S3 and ESP32-C3" } = Astro.props;
// A site path gets the base prefix; an absolute URL (the firmware library) is used as is.
const manifestUrl = /^https?:\/\//.test(manifest) ? manifest : link(manifest);
---

<div class="flashbox">
  <esp-web-install-button manifest={manifestUrl}>
    <button slot="activate" class="btn go" type="button">Flash firmware {version}</button>
    <p slot="unsupported" class="notice"><strong>This browser cannot flash.</strong> Use Chrome or Edge on a desktop.</p>
    <p slot="not-allowed" class="notice"><strong>Flashing needs a secure page.</strong> Open this site over https or from http://localhost.</p>
  </esp-web-install-button>
  <p class="cap left">One image per chip family: {families}. The installer detects which one is connected.</p>
</div>

<script>
  import "esp-web-tools/dist/web/install-button.js";
</script>
