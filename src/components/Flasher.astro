---
// Browser install button, the same ESP Web Tools setup ProbeHarbor uses on /flash.
// The manifest picks the right image for the connected chip family.
import { localLink } from "../lib/paths";

const link = localLink(Astro.currentLocale);

interface Props {
  manifest: string;
  version: string;
  /** Chip families the manifest has images for, for the caption */
  families?: string;
  /** Project id, so a finished flash counts towards the bench log's "No IDE required" badge */
  project?: string;
}

const { manifest, version, families = "ESP32, ESP32-S3 and ESP32-C3", project } = Astro.props;
// A site path gets the base prefix; an absolute URL (the firmware library) is used as is.
const manifestUrl = /^https?:\/\//.test(manifest) ? manifest : link(manifest);
---

<div class="flashbox" data-project={project}>
  <esp-web-install-button manifest={manifestUrl}>
    <button slot="activate" class="btn go" type="button">Flash to your board</button>
    <p slot="unsupported" class="notice"><strong>This browser cannot flash.</strong> Use Chrome or Edge on a desktop.</p>
    <p slot="not-allowed" class="notice"><strong>Flashing needs a secure page.</strong> Open this site over https or from http://localhost.</p>
  </esp-web-install-button>
  <p class="cap left">{version && `Firmware ${version}. `}One image per chip family: {families}. The installer detects which one is connected.</p>
</div>

<script>
  import "esp-web-tools/dist/web/install-button.js";
  import { markFlashed } from "../scripts/progress";

  // ESP Web Tools has no public "flash finished" event. Its dialog fires "closed"
  // (bubbling, from <body>) and keeps the last flash state in _installState, so
  // read that on close. tests/flash-hook.test.ts fails if a new version drops it.
  let lastProject = "";
  document.addEventListener("click", (event) => {
    const box = (event.target as Element | null)?.closest?.<HTMLElement>(".flashbox");
    if (box) lastProject = box.dataset.project ?? "";
  });
  document.addEventListener("closed", (event) => {
    const dialog = event.target as (Element & { _installState?: { state?: string } }) | null;
    if (dialog?.localName !== "ewt-install-dialog" || !lastProject) return;
    if (dialog._installState?.state === "finished") markFlashed(lastProject);
  });
</script>
