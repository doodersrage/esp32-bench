---
import Base from "../layouts/Base.astro";
import { PROJECTS } from "../data/projects";

const bauds = [9600, 57600, 74880, 115200, 230400, 460800, 921600];
---

<Base
  title="ESP32 serial monitor in your browser"
  current="bench"
  description="A Web Serial monitor for ESP32 boards: connect, send lines, reset, plot numbers live, map Wi-Fi networks and get crashes explained in plain language. No install."
>
  <section class="view">
    <div class="benchhead">
      <h1 class="h2">Serial bench</h1>
      <span class="status" id="status"><span class="dot"></span><span id="status-text">No board</span></span>
    </div>

    <div class="notice" id="support" hidden>
      <strong>This browser has no Web Serial.</strong> Open this page in Chrome or Edge on a desktop to connect a board. The library and sample output work everywhere.
    </div>

    <div class="controls">
      <label for="baud">
        Baud
        <select id="baud">
          {bauds.map((b) => <option value={b} selected={b === 115200}>{b}</option>)}
        </select>
      </label>
      <button class="btn go" id="connect" type="button">Connect board</button>
      <button class="btn" id="reset" type="button" disabled>Reset board</button>
      <span class="sp"></span>
      <label for="stamps"><input type="checkbox" id="stamps" /> Timestamps</label>
      <label for="follow"><input type="checkbox" id="follow" checked /> Follow</label>
      <label for="sound"><input type="checkbox" id="sound" /> Sound</label>
      <button class="btn sm" id="copylog" type="button">Copy log</button>
      <button class="btn sm" id="sharelog" type="button">Share log</button>
      <button class="btn sm" id="clear" type="button">Clear</button>
    </div>
    <div class="shareout" id="share-term" hidden></div>

    <div class="samplebar">
      <span>No board handy?</span>
      <select id="samplepick" aria-label="Project for sample output">
        {PROJECTS.map((p) => <option value={p.id}>{p.name}</option>)}
      </select>
      <button class="btn sm" id="sample" type="button">Play sample output</button>
      <span class="sp"></span>
      <button class="btn sm" id="second-toggle" type="button" aria-expanded="false" aria-controls="second">Add a second board</button>
    </div>

    <div class="terms" id="terms">
      <div class="stack tight pane">
        <div class="term" id="term" role="log" aria-label="Serial output" tabindex="0"></div>

        <form class="send" id="sendform">
          <input type="text" id="tx" placeholder="Type a line to send" aria-label="Line to send" autocomplete="off" disabled />
          <select id="eol" aria-label="Line ending">
            <option value="lf">LF</option>
            <option value="crlf">CR LF</option>
            <option value="cr">CR</option>
            <option value="none">None</option>
          </select>
          <button class="btn" id="sendbtn" type="submit" disabled>Send</button>
        </form>
      </div>
      <div class="stack tight pane" id="second" hidden>
        <div class="controls">
          <label for="baud2">
            Baud
            <select id="baud2">
              {bauds.map((b) => <option value={b} selected={b === 115200}>{b}</option>)}
            </select>
          </label>
          <button class="btn go" id="connect2" type="button">Connect second board</button>
          <button class="btn" id="reset2" type="button" disabled>Reset board</button>
          <span class="sp"></span>
          <button class="btn sm" id="clear2" type="button">Clear</button>
        </div>
        <div class="term" id="term2" role="log" aria-label="Serial output from the second board" tabindex="0"></div>
        <form class="send" id="sendform2">
          <input type="text" id="tx2" placeholder="Type a line to send" aria-label="Line to send to the second board" autocomplete="off" disabled />
          <button class="btn" id="sendbtn2" type="submit" disabled>Send</button>
        </form>
      </div>
    </div>


    <div class="stack tight">
      <div class="codehead">
        <h2 class="h3">Plotter</h2>
        <button class="btn sm" type="button" id="plots-csv" hidden>Download CSV</button>
      </div>
      <p class="lede" id="plots-empty">Numbers that keep appearing in the output are charted here, one chart per value. Play the DHT22 or HC-SR04 sample to see it.</p>
      <div class="plots" id="plots"></div>
    </div>

    <div class="stack tight" id="radar" hidden>
      <h2 class="h3">Wi-Fi radar</h2>
      <canvas class="radar" role="img" aria-label="Nearby Wi-Fi networks by channel and signal strength"></canvas>
      <p class="cap left" data-radar-note></p>
    </div>

    <details class="translator" id="translator">
      <summary>Crash translator</summary>
      <div class="stack tight">
        <label for="crashlog">Paste a boot log or crash output</label>
        <textarea id="crashlog" rows="5" spellcheck="false" placeholder="Guru Meditation Error: Core  1 panic'ed (LoadProhibited). Exception was unhandled."></textarea>
        <div class="row">
          <button class="btn" id="crashgo" type="button">Explain it</button>
          <button class="btn" id="crashshare" type="button">Share as a link</button>
        </div>
        <div class="shareout" id="share-paste" hidden></div>
        <ul class="notes" id="crashout"></ul>
      </div>
    </details>
  </section>
</Base>

<script>
  import "../scripts/bench.ts";
</script>
