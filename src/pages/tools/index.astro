---
import Base from "../../layouts/Base.astro";
import { link } from "../../lib/paths";
import { TOOLS } from "../../data/tools";


---

<Base
  title="ESP32 tools in your browser"
  current="tools"
  description="Free ESP32 tools that run in the browser: backtrace decoder, web flasher, partition table builder, serial monitor, pin finder and wiring checker. Nothing to install, nothing uploaded."
>
  <section class="view">
    <div class="stack tight">
      <h1 class="h2">Tools</h1>
      <p class="lede">
        Everything here runs in this page. Files you open and data from your board stay on your computer. The tools that
        talk to a board need Chrome, Edge or Opera on a desktop.
      </p>
    </div>
    <div class="grid">
      {
        TOOLS.map((t, i) => (
          <a class="card" href={link(t.href)}>
            <span class="no">Tool {String(i + 1).padStart(2, "0")}</span>
            <span class="name">{t.name}</span>
            <span class="sum">{t.sum}</span>
            <span class="meta">
              {t.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
