---
import Base from "../layouts/Base.astro";
import Pinout from "../components/Pinout.astro";
import { BOARDS } from "../data/boards";
import { PROJECTS, boardsOf } from "../data/projects";
import { AFFILIATE_DISCLOSURE, shopRel, shopVendor } from "../lib/shop";

const countFor = (id: string) => PROJECTS.filter((p) => boardsOf(p).some((b) => b === id)).length;
---

<Base
  title="ESP32, ESP32-S3 and ESP32-C3 pinouts"
  current="boards"
  description="Pin headers, hardware-tested pins and field notes for the ESP32-DevKitC V4, ESP32-S3-DevKitC-1 and ESP32-C3-DevKitM-1: boot pins, input-only pins and safe GPIOs."
>
  <section class="view">
    <h1 class="h2">Boards</h1>
    <p class="lede">
      Header layouts follow Espressif's user guides. The tested pins and field notes come from ProbeHarbor's hardware
      test log, where each board was flashed and run with real sensors.
    </p>

    {
      BOARDS.map((b) => (
        <article class="cols boardcard" id={b.id}>
          <Pinout board={b} />
          <div class="stack">
            <div class="stack tight">
              <h2>{b.name}</h2>
              <div class="meta">
                <span class="tag lvl">Arduino: {b.arduinoBoard}</span>
                <span class="tag">{countFor(b.id)} projects</span>
              </div>
            </div>
            <div>
              <h3>Pins tested on hardware</h3>
              <div class="tablebox">
                <table>
                  <tbody>
                    <tr>
                      <td>I2C</td>
                      <td class="m">{b.tested.i2c}</td>
                    </tr>
                    <tr>
                      <td>One-wire or DHT data</td>
                      <td class="m">{b.tested.probe}</td>
                    </tr>
                    <tr>
                      <td>BOOT button</td>
                      <td class="m">{b.tested.boot}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div>
              <h3>Field notes</h3>
              <ul class="notes">
                {b.notes.map((n) => <li>{n}</li>)}
              </ul>
            </div>
            <div class="row">
              {b.buy.map((x) => (
                <a class="btn sm" href={x.href} rel={shopRel(x.href)} target="_blank">
                  Buy {x.label} at {shopVendor(x.href)}
                </a>
              ))}
              <a class="btn sm" href={b.source} rel="noopener noreferrer" target="_blank">Espressif user guide</a>
            </div>
          </div>
        </article>
      ))
    }

    <p class="cap left">{AFFILIATE_DISCLOSURE}</p>
  </section>
</Base>
