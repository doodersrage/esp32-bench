---
import { localePaths } from "../../../i18n/locales";
import Base from "../../../layouts/Base.astro";
import { localLink } from "../../../lib/paths";
import { SITE } from "../../../lib/site";
import { translator } from "../../../i18n/t";
import { TOOLS_UI } from "../../../i18n/strings/tools";

const link = localLink(Astro.currentLocale);
const t = translator(TOOLS_UI, Astro.currentLocale);

export const getStaticPaths = localePaths;
---

<Base
  title={t("btTitle")}
  current="tools"
  image="/og/tools/backtrace.png"
  description={t("btDescription")}
>
  <section class="view">
    <a class="back" href={link("/tools/")}>{t("allTools")}</a>
    <div class="stack tight">
      <h1 class="h2">{t("btH1")}</h1>
      <p class="lede" set:html={t("btLede")} />
    </div>

    <div class="cols even">
      <div class="stack tight">
        <h2 class="h3">{t("btStep1")}</h2>
        <label class="drop" id="bt-drop">
          <input type="file" id="bt-elf" accept=".elf,application/x-elf,application/octet-stream" />
          <span class="dropmain">{t("btDrop")}</span>
          <span class="dropsub" id="bt-elf-status">{t("btDropSub")}</span>
        </label>
        <details class="where">
          <summary>{t("btWhere")}</summary>
          <ul>
            <li set:html={t("btWhereArduino")} />
            <li set:html={t("btWherePio")} />
            <li set:html={t("btWhereIdf")} />
          </ul>
        </details>
      </div>
      <div class="stack tight">
        <h2 class="h3">{t("btStep2")}</h2>
        <textarea id="bt-log" data-fw={SITE.fwBase} rows="8" spellcheck="false" placeholder={t("btPlaceholder")}></textarea>
        <div class="row">
          <button class="btn go" type="button" id="bt-go">{t("btDecode")}</button>
          <button class="btn" type="button" id="bt-clear">{t("btClear")}</button>
          <span class="cap left" id="bt-status" role="status"></span>
        </div>
      </div>
    </div>

    <div class="stack tight" id="bt-result" hidden>
      <h2 class="h3">{t("btFrames")}</h2>
      <ul class="notes" id="bt-hints"></ul>
      <div class="tablebox">
        <table class="bt">
          <thead>
            <tr>
              <th>#</th>
              <th>{t("btThFrom")}</th>
              <th>{t("btThAddress")}</th>
              <th>{t("btThFunction")}</th>
              <th>{t("btThSource")}</th>
            </tr>
          </thead>
          <tbody id="bt-rows"></tbody>
        </table>
      </div>
      <p class="cap left" set:html={t("btLegend")} />
    </div>

    <p class="cap left" set:html={t("btFoot", { errors: link("/errors/"), bench: link("/bench/") })} />
  </section>
</Base>

<style>
  .drop { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 18px 14px; border: 2px dashed var(--line); background: var(--panel); cursor: pointer; text-align: center; }
  .drop:hover, .drop.over { border-color: var(--accent); }
  .drop.loaded { border-style: solid; border-color: var(--ok); }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .drop:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dropmain { font: 700 1.2rem/1.1 var(--display); text-transform: uppercase; }
  .dropsub { font-size: 0.85rem; color: var(--muted); overflow-wrap: anywhere; }
  .where { font-size: 0.9rem; }
  .where summary { cursor: pointer; color: var(--muted); }
  .where ul { margin: 8px 0 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px; }
  textarea { width: 100%; padding: 8px 10px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 2px; font: 400 0.8rem/1.5 var(--mono); resize: vertical; }
  table.bt td { font-size: 0.85rem; }
  table.bt td.fn { font-family: var(--mono); font-size: 0.8rem; overflow-wrap: anywhere; min-width: 14ch; }
  table.bt td.src { font-family: var(--mono); font-size: 0.8rem; overflow-wrap: anywhere; }
  table.bt .dim { color: var(--muted); }
  table.bt tr.sketch td { background: var(--pad-soft); }
  .tag.sk, .cap :global(.tag.sk) { border-color: var(--pad); color: var(--pad); background: var(--pad-soft); }
  .lede :global(a), .cap :global(a) { color: var(--accent); }
</style>

<script>
  import "../../../scripts/backtrace-page.ts";
</script>
