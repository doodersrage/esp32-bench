---
import { localePaths } from "../../../i18n/locales";
import Base from "../../../layouts/Base.astro";
import { localLink } from "../../../lib/paths";
import { TOOLS } from "../../../data/tools";
import { translator } from "../../../i18n/t";
import { TOOLS_UI, toolText } from "../../../i18n/strings/tools";

const link = localLink(Astro.currentLocale);
const t = translator(TOOLS_UI, Astro.currentLocale);
const tt = (english: string) => toolText(english, Astro.currentLocale);

export const getStaticPaths = localePaths;
---

<Base
  title={t("indexTitle")}
  current="tools"
  image="/og/tools/index.png"
  description={t("indexDescription")}
>
  <section class="view">
    <div class="stack tight">
      <h1 class="h2">{t("indexH1")}</h1>
      <p class="lede">{t("indexLede")}</p>
    </div>
    <div class="grid">
      {
        TOOLS.map((tool, i) => (
          <a class="card" href={link(tool.href)}>
            <span class="no">{t("toolNo", { n: String(i + 1).padStart(2, "0") })}</span>
            <span class="name">{tt(tool.name)}</span>
            <span class="sum">{tt(tool.sum)}</span>
            <span class="meta">
              {tool.tags.map((tag) => (
                <span class="tag">{tt(tag)}</span>
              ))}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
