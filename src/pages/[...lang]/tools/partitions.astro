---
import { localePaths } from "../../../i18n/locales";
import Base from "../../../layouts/Base.astro";
import { localLink } from "../../../lib/paths";
import { PRESETS } from "../../../lib/partitions";
import { translator } from "../../../i18n/t";
import { TOOLS_UI } from "../../../i18n/strings/tools";

const link = localLink(Astro.currentLocale);
const t = translator(TOOLS_UI, Astro.currentLocale);
const presetLabel = (p: { id: string; label: string }) => {
  const key = `preset_${p.id}`;
  return key in TOOLS_UI.en ? t(key as keyof typeof TOOLS_UI.en) : p.label;
};

export const getStaticPaths = localePaths;
---

<Base
  title={t("ptTitle")}
  current="tools"
  image="/og/tools/partitions.png"
  description={t("ptDescription")}
>
  <section class="view">
    <a class="back" href={link("/tools/")}>{t("allTools")}</a>
    <div class="stack tight">
      <h1 class="h2">{t("ptH1")}</h1>
      <p class="lede">{t("ptLede")}</p>
    </div>

    <div class="controls">
      <label>{t("ptStart")}
        <select id="pt-preset">
          {PRESETS.map((p) => <option value={p.id}>{presetLabel(p)}</option>)}
        </select>
      </label>
      <label>{t("ptFlash")}
        <select id="pt-flash">
          {[2, 4, 8, 16, 32].map((n) => <option value={n} selected={n === 4}>{n} MB</option>)}
        </select>
      </label>
      <label><input type="checkbox" id="pt-auto" checked /> {t("ptAuto")}</label>
    </div>

    <div class="ptbar" id="pt-bar" aria-hidden="true"></div>
    <p class="cap left" id="pt-summary" role="status"></p>

    <div class="tablebox">
      <table class="pt">
        <thead>
          <tr>
            <th>{t("ptThName")}</th>
            <th>{t("ptThType")}</th>
            <th>{t("ptThSubtype")}</th>
            <th>{t("thOffset")}</th>
            <th>{t("thSize")}</th>
            <th><span class="sr">{t("ptThActions")}</span></th>
          </tr>
        </thead>
        <tbody id="pt-rows"></tbody>
      </table>
    </div>
    <div class="row">
      <button class="btn" type="button" id="pt-add">{t("ptAdd")}</button>
      <button class="btn" type="button" id="pt-fill">{t("ptFill")}</button>
    </div>
    <p class="cap left">{t("ptSizesCap")}</p>

    <ul class="findings" id="pt-problems"></ul>

    <div class="stack tight">
      <div class="codehead">
        <h2 class="h3 flat">partitions.csv</h2>
        <div class="row">
          <button class="btn sm" type="button" id="pt-copy">{t("copy")}</button>
          <button class="btn sm go" type="button" id="pt-download">{t("download")}</button>
        </div>
      </div>
      <pre class="code" id="pt-csv"></pre>
    </div>

    <details class="import">
      <summary>{t("ptImport")}</summary>
      <textarea id="pt-import" rows="7" spellcheck="false" placeholder="# Name, Type, SubType, Offset, Size, Flags"></textarea>
      <div class="row">
        <button class="btn sm" type="button" id="pt-import-go">{t("ptLoad")}</button>
        <span class="cap left" id="pt-import-status" role="status"></span>
      </div>
    </details>

    <div class="stack tight band">
      <h2>{t("ptUse")}</h2>
      <ul class="howto">
        <li set:html={t("ptUseArduino")} />
        <li set:html={t("ptUsePio")} />
        <li set:html={t("ptUseIdf")} />
        <li set:html={t("ptUseFs")} />
      </ul>
      <p class="cap left" set:html={t("ptTooBig", { href: link("/errors/sketch-too-big/") })} />
    </div>
  </section>
</Base>

<style>
  .tablebox { min-width: 0; max-width: 100%; }
  .ptbar { display: flex; height: 44px; border: 1px solid var(--line); background: var(--panel); overflow: hidden; }
  .ptbar :global(.seg) { display: flex; align-items: center; justify-content: center; min-width: 2px; font: 500 0.7rem/1.1 var(--mono); color: #fff; overflow: hidden; white-space: nowrap; border-right: 1px solid var(--panel); padding: 0 2px; }
  .ptbar :global(.seg.app) { background: var(--accent); }
  .ptbar :global(.seg.data) { background: var(--pad); }
  .ptbar :global(.seg.boot) { background: var(--muted); }
  .ptbar :global(.seg.free) { background: transparent; color: var(--muted); }
  .ptbar :global(.seg.bad) { background: repeating-linear-gradient(45deg, var(--accent), var(--accent) 4px, var(--ink) 4px, var(--ink) 8px); }
  table.pt :global(input), table.pt :global(select) { width: 100%; min-width: 8ch; padding: 5px 6px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 2px; font: 400 0.82rem/1.2 var(--mono); }
  table.pt :global(input:disabled) { color: var(--muted); background: transparent; }
  table.pt :global(tr.bad) :global(td) { background: var(--pad-soft); }
  table.pt :global(td.acts) { white-space: nowrap; }
  table.pt :global(td.acts button) { padding: 4px 8px; min-width: 2.2em; }
  .import { background: var(--panel); border: 1px solid var(--line); padding: 10px 14px; }
  .import summary { cursor: pointer; font-weight: 500; }
  .import textarea { width: 100%; margin: 10px 0 8px; padding: 8px 10px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 0.8rem/1.5 var(--mono); }
  ul.howto { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; max-width: 75ch; font-size: 0.92rem; }
  .cap :global(a) { color: var(--accent); }
</style>

<script>
  import "../../../scripts/partitions-page.ts";
</script>
