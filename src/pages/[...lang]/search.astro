---
import { localePaths } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
import { localLink } from "../../lib/paths";
import { SEARCH } from "../../i18n/strings/pages";
import { translator } from "../../i18n/t";

const link = localLink(Astro.currentLocale);
const t = translator(SEARCH, Astro.currentLocale);

export const getStaticPaths = localePaths;
---

<Base title={t("title")} current="search" description={t("description")}>
  <section class="view">
    <h1 class="h2">{t("h1")}</h1>
    <form class="spage" id="search-form" role="search" action={link("/search/")} method="get">
      <label class="sr" for="search-q">{t("label")}</label>
      <input
        id="search-q"
        name="q"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder={t("placeholder")}
        autofocus
      />
      <button class="btn go" type="submit">{t("button")}</button>
    </form>
    <p class="lede" id="search-count" role="status" aria-live="polite">{t("hint")}</p>
    <ol class="sresults" id="search-results"></ol>
    <noscript>
      <p class="notice">
        <strong>{t("noscriptHead")}</strong> <Fragment set:html={t("noscript", { library: link("/"), errors: link("/errors/") })} />
      </p>
    </noscript>
  </section>
</Base>

<script>
  import "../../scripts/search-page.ts";
</script>
