---
import { localePaths } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { DRAWER, DRAWER_GROUPS, LEVELS, PROJECTS, TAGS, bareBoard, boardsOf } from "../../data/projects";
import { BOARDS } from "../../data/boards";
import { PATHS } from "../../data/paths";
import { BADGES } from "../../scripts/progress";
import { SITE } from "../../lib/site";
import { localLink } from "../../lib/paths";
import { translator } from "../../i18n/t";
import { contentTranslator } from "../../i18n/content";
import { SHELL } from "../../i18n/strings/shell";
import { OFFLINE } from "../../i18n/strings/offline";
import { BADGE_TEXT, DRAWER_NAMES, GROUP_NAMES, HOME, LEVEL_NAMES, PATH_TEXT, TAG_NAMES, dataLabel } from "../../i18n/strings/home";

const link = localLink(Astro.currentLocale);
const t = translator(HOME, Astro.currentLocale);
const to = translator(OFFLINE, Astro.currentLocale);
const tc = contentTranslator(Astro.currentLocale);
const drawerName = dataLabel(DRAWER_NAMES, Astro.currentLocale);
const groupName = dataLabel(GROUP_NAMES, Astro.currentLocale) as (id: string, english: string) => string;
const tagName = dataLabel(TAG_NAMES, Astro.currentLocale);
const levelName = dataLabel(LEVEL_NAMES, Astro.currentLocale);
const badgeText = dataLabel(BADGE_TEXT, Astro.currentLocale);
const pathText = dataLabel(PATH_TEXT, Astro.currentLocale);

// Build-time checks so the picker and the "No extra parts" filter cannot drift
// from the data as projects are added.
const grouped = DRAWER_GROUPS.flatMap(([, ids]) => ids);
const ungrouped = Object.keys(DRAWER).filter((id) => !grouped.includes(id as keyof typeof DRAWER));
const doubled = grouped.filter((id, i) => grouped.indexOf(id) !== i);
if (ungrouped.length || doubled.length) {
  throw new Error(`DRAWER_GROUPS: ungrouped ${ungrouped.join(", ") || "none"}; listed twice ${doubled.join(", ") || "none"}`);
}
const tagMismatch = PROJECTS.filter((p) => bareBoard(p) !== p.tags.includes("no-parts")).map((p) => p.id);
if (tagMismatch.length) {
  throw new Error(`The "no-parts" tag should be on exactly the projects with no needs: check ${tagMismatch.join(", ")}`);
}
const bareCount = PROJECTS.filter(bareBoard).length;
const missingSteps = PATHS.flatMap((path) => path.steps.filter((s) => !PROJECTS.some((p) => p.id === s.project)).map((s) => `${path.id}: ${s.project}`));
if (missingSteps.length) throw new Error(`Starter paths name projects that do not exist: ${missingSteps.join(", ")}`);
const projectName = (id: string) => tc(PROJECTS.find((p) => p.id === id)?.name ?? id);

// "Suggested" order: runs on a bare board, Starter level and hardware tested
// float up; ProbeHarbor's own sketches (useful mostly to ProbeHarbor users)
// sink. Ties keep the quicker build first, then the library's own order.
const score = (p: (typeof PROJECTS)[number]) =>
  (bareBoard(p) ? 3 : 0) + (p.level === "Starter" ? 2 : 0) + ((p.verified ?? []).length > 0 ? 2 : 0) - (p.id.startsWith("ph-") ? 4 : 0);
const suggested = PROJECTS.map((p, i) => ({ p, i }))
  .sort((a, b) => score(b.p) - score(a.p) || a.p.mins - b.p.mins || a.i - b.i)
  .map(({ p }) => p.id);
const boardOptions = BOARDS.map((b) => ({ id: b.id, name: b.name, count: PROJECTS.filter((p) => boardsOf(p).includes(b.id)).length }));

export const getStaticPaths = localePaths;
---

<Base
  current="library"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    description: translator(SHELL, Astro.currentLocale)("description"),
    url: Astro.site?.href,
    author: { "@type": "Person", name: SITE.author.name, url: SITE.author.url },
  }}
>
  <section class="view">
    <h1 class="sr">{t("h1")}</h1>
    <p class="lede">{t("lede", { n: PROJECTS.length })}</p>
    <div class="filters">
      <input type="search" id="q" placeholder={t("searchPlaceholder")} aria-label={t("searchLabel")} />
      <div class="row scrollrow" id="chips">
        {
          TAGS.map(([id, label]) => (
            <button class="chip" type="button" data-tag={id} aria-pressed={id === "all" ? "true" : "false"}>
              {tagName(id, label)}
            </button>
          ))
        }
      </div>
      <div class="row" id="levels" role="group" aria-label={t("level")}>
        {
          LEVELS.map(([id, label]) => (
            <button class="chip sm" type="button" data-level={id} aria-pressed={id === "all" ? "true" : "false"}>
              {levelName(id, label)}
            </button>
          ))
        }
        <label class="pick">
          <span class="sr">{t("board")}</span>
          <select id="board-filter">
            <option value="all">{t("anyBoard")}</option>
            {boardOptions.map((b) => <option value={b.id}>{b.name} ({b.count})</option>)}
          </select>
        </label>
        <label class="pick">
          <span class="sr">{t("order")}</span>
          <select id="sort">
            <option value="suggested">{t("sortSuggested")}</option>
            <option value="newest">{t("sortNewest")}</option>
            <option value="quickest">{t("sortQuickest")}</option>
          </select>
        </label>
        <button class="chip sm" type="button" id="lab-only" aria-pressed="false" hidden title={t("labTitle")}>{t("labTested")}</button>
        <a class="loglink" href="#log" id="loglink">{t("logLink")}</a>
        <a class="loglink2" href={link("/shop/")} id="shop-count" hidden>{t("shopLink")}</a>
      </div>
    </div>

    <details class="drawer" id="drawer">
      <summary>{t("drawerSummary")}</summary>
      <p class="lede">{t("drawerLede", { n: bareCount })}</p>
      {
        DRAWER_GROUPS.map(([label, ids]) => (
          <div class="partgroup">
            <h3 class="partlabel">{groupName(label, label)}</h3>
            <div class="row">
              {ids.map((id) => (
                <button class="chip" type="button" data-part={id} aria-pressed="false">
                  {drawerName(id, DRAWER[id])}
                </button>
              ))}
            </div>
          </div>
        ))
      }
      <p class="unlock" id="unlock" role="status"></p>
      <div class="row">
        <button class="btn go" type="button" id="pick">{t("pick")}</button>
        <span class="pickresult" id="pick-result" role="status"></span>
      </div>
    </details>

    <div class="grid" id="grid" data-lab={SITE.labLatestApi}>
      {
        suggested.map((id, rank) => {
          const i = PROJECTS.findIndex((p) => p.id === id);
          return <ProjectCard project={PROJECTS[i]} number={rank + 1} order={i + 1} suggest={rank} />;
        })
      }
    </div>
    <div class="empty" id="empty" hidden>{t("empty")}</div>

    <div class="stack tight band" id="paths">
      <h2>{t("pathsHead")}</h2>
      <p class="lede">{t("pathsLede")}</p>
      <div class="paths">
        {
          PATHS.map((path) => (
            <div class="path" data-path={path.id}>
              <h3 class="pathname">{pathText(`${path.id}.name`, path.name)}</h3>
              <p class="pathblurb">{pathText(`${path.id}.blurb`, path.blurb)}</p>
              <div class="pathbar" aria-hidden="true"><span data-path-bar></span></div>
              <p class="pathcount" data-path-count>{t("steps", { n: path.steps.length })}</p>
              <ol class="pathsteps">
                {path.steps.map((s) => (
                  <li data-step={s.project}>
                    <a href={link(`/projects/${s.project}/`)}>{projectName(s.project)}</a>
                    <span>{pathText(`${path.id}.${s.project}`, s.learn)}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </div>

    <div class="stack tight band" id="log">
      <h2>{t("logHead")}</h2>
      <p class="lede" id="log-summary">{t("logLede")}</p>
      <div class="sync" id="sync" data-sitekey={SITE.turnstileSitekey}>
        <h3 class="synchead">{t("syncHead")}</h3>
        <div class="stack tight" id="sync-off">
          <p>{t("syncIntro")}</p>
          <div class="syncrow">
            <button class="btn go" type="button" id="sync-make">{t("syncMake")}</button>
            <div id="sync-human"></div>
          </div>
          <form class="syncrow" id="sync-link">
            <label for="sync-code">{t("syncHave")}</label>
            <input id="sync-code" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="7KQ4-M2XD-9PQA-R3TW" />
            <button class="btn" type="submit">{t("syncLinkBtn")}</button>
          </form>
          <p class="cap left">{t("syncGithubWhy")}</p>
          <div class="syncrow">
            <button class="btn" type="button" id="sync-github">{t("syncGithub")}</button>
          </div>
        </div>
        <div class="stack tight" id="sync-on" hidden>
          <p data-sync-code set:html={t("syncShown", { code: '<code class="synccode" id="sync-shown"></code>' })} />
          <p data-sync-github hidden>{t("syncGithubShown")}</p>
          <div class="syncrow">
            <button class="btn sm" type="button" id="sync-copy" data-sync-code>{t("syncCopy")}</button>
            <button class="btn sm" type="button" id="sync-copylink" data-sync-code>{t("syncCopyLink")}</button>
            <button class="btn sm" type="button" id="sync-save" data-sync-code>{t("syncSave")}</button>
            <button class="btn sm" type="button" id="sync-unlink" data-sync-code>{t("syncUnlink")}</button>
            <button class="btn sm" type="button" id="sync-signout" data-sync-github hidden>{t("syncSignOut")}</button>
            <button class="btn sm" type="button" id="sync-delete">{t("syncDelete")}</button>
          </div>
          <p class="cap left" id="sync-when"></p>
          <p class="cap left" data-sync-code>{t("syncLost")}</p>
        </div>
        <p class="cap left" id="sync-status" role="status"></p>
      </div>
      <div class="sync keptcard" id="offline">
        <h3 class="synchead">{to("cardTitle")}</h3>
        <p>{to("cardIntro")}</p>
        <p class="cap left" data-kept-empty>{to("cardEmpty")}</p>
        <ul class="keptlist" data-kept-list></ul>
        <p class="cap left" data-kept-total></p>
        <p class="cap left">{to("cardInstall")}</p>
      </div>
      <ul class="badges">
        {
          BADGES.map((b) => (
            <li class="badge" data-badge={b.id}>
              <span class="badgename">{badgeText(`${b.id}.name`, b.name)}</span>
              <span class="badgehow">{badgeText(`${b.id}.how`, b.how)}</span>
              <span class="badgestate" data-badge-state>{t("locked")}</span>
            </li>
          ))
        }
      </ul>

    </div>
  </section>
</Base>

<script>
  import "../../scripts/library.ts";
  import "../../scripts/sync-ui.ts";
</script>
