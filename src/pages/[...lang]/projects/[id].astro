---
import { withLocales } from "../../../i18n/locales";
import { translator } from "../../../i18n/t";
import { contentTranslator } from "../../../i18n/content";
import { PROJECT } from "../../../i18n/strings/project";
import Base from "../../../layouts/Base.astro";
import Comments from "../../../components/Comments.astro";
import Preview from "../../../components/Preview.astro";
import Pinout from "../../../components/Pinout.astro";
import WiringDiagram from "../../../components/WiringDiagram.astro";
import Flasher from "../../../components/Flasher.astro";
import FirmwareLibrary from "../../../components/FirmwareLibrary.astro";
import { LAB_EXPECT } from "../../../data/lab-expect";
import ProbeSetup from "../../../components/ProbeSetup.astro";
import SettingsForm from "../../../components/SettingsForm.astro";
import SketchBuilder from "../../../components/SketchBuilder.astro";
import COMPILE from "../../../data/compile-libs.json";
import { PROJECTS, boardsOf, forBoard, type Project } from "../../../data/projects";
import { BOARDS, boardById, buildChoices, buildTarget, type BoardId } from "../../../data/boards";
import { localLink } from "../../../lib/paths";
import { PROBEHARBOR, SITE, absolute, reportUrl } from "../../../lib/site";
import { buyFor, shopVendor } from "../../../lib/shop";
import { kitFor } from "../../../lib/kit";
import { PATHS } from "../../../data/paths";
import { PAGE_PALETTE, kitIconSvg } from "../../../lib/kit-icons";

const link = localLink(Astro.currentLocale);
const t = translator(PROJECT, Astro.currentLocale);
// Project prose in this page's language; the logic below keeps working on the English data.
const tc = contentTranslator(Astro.currentLocale);

export function getStaticPaths() {
  return withLocales(PROJECTS.map((p) => ({ params: { id: p.id }, props: { p } })));
}

interface Props {
  p: Project;
}

const { p } = Astro.props;
const name = tc(p.name);
const sum = tc(p.sum);
// A board's %VAR% values, as forBoard() fills them (a variant board borrows its parent's).
const varsOf = (board: BoardId): Record<string, string> => {
  const own = p.vars?.[board];
  if (own) return own;
  const parent = BOARDS.find((b) => b.id === board)?.variantOf;
  return (parent && p.vars?.[parent]) ?? {};
};
// Translate the template and each value before filling, so phrases match the English source.
const fillT = (text: string, vars: Record<string, string>) =>
  tc(text).replace(/%([A-Z]+)%/g, (whole, key: string) => (vars[key] !== undefined ? tc(vars[key]) : whole));
const boards = boardsOf(p).map(boardById);
const panels = boards.map((board) => {
  const vars = varsOf(board.id);
  return {
    board,
    ...forBoard(p, board.id),
    shownWiring: p.wiring.map((row) => row.map((cell) => fillT(cell, vars))),
    verified: (p.verified ?? []).filter((v) => v.board === board.id),
  };
});
const needsLibraries = p.libs.some((l) => !/built in/.test(l));
const buy = p.parts.map((x) => buyFor(x));
const buyText = (href: string) => {
  const vendor = shopVendor(href);
  return vendor === "Amazon" && new URL(href).pathname === "/s" ? t("buyFind") : t("buyAt", { vendor });
};
const libText = (lib: string) => lib.replace("(built into the ESP32 core)", `(${t("builtInCore")})`).replace("(built in)", `(${t("builtIn")})`);
const hasBuyLinks = buy.some(Boolean);
// "What you'll need": the kit card image and an icon per parts row.
const kit = kitFor(p.parts);
const kitAlt = t("kitAlt", {
  name,
  list: kit
    .map((k) => {
      const label = tc(k.label);
      const item = k.alternative ? t("kitAltOr", { label }) : t("kitAltQty", { qty: k.qty, label });
      return k.optional ? t("kitAltOptional", { item }) : item;
    })
    .join(", "),
});
const kitSrc = link(`/og/kits/${p.id}.png`);
const buildReportUrl = reportUrl("build", { project: p.id });
// Starter paths this project is a step of, with the step after it.
const onPaths = PATHS.flatMap((path) => {
  const at = path.steps.findIndex((s) => s.project === p.id);
  if (at < 0) return [];
  const next = path.steps[at + 1];
  return [{ name: t(`path.${path.id}` as "path.first-week"), step: at + 1, of: path.steps.length, next: next && PROJECTS.find((x) => x.id === next.project) }];
});
const escapeHtml = (x: string) => x.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const anyVerified = (p.verified ?? []).length > 0;
// Long sketches show this many lines until "Show the whole sketch".
const CLIP_LINES = 26;
const benchHref = `${link("/bench/")}?baud=${p.baud}&sample=${p.id}`;
const boardNames = boards.map((b) => b.name).join(", ");
const summary = sum.length > 150 ? `${sum.slice(0, sum.lastIndexOf(" ", 147))}...` : sum;
const description = t("description", { summary, boards: boardNames });
// "What it prints": only projects that need nothing attached can have a QEMU preview (scripts/emulate-firmware.mjs).
// Structured data: the project as a how-to (parts, time, steps), on the first
// board it supports, so search engines and answer engines can quote it.
const first = panels[0];
const howTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name,
  description: sum,
  inLanguage: Astro.currentLocale === "pt-br" ? "pt-BR" : (Astro.currentLocale ?? "en"),
  totalTime: `PT${p.mins}M`,
  image: absolute(`/og/projects/${p.id}.png`, Astro.site),
  supply: p.parts.map(([qty, what]) => ({ "@type": "HowToSupply", name: tc(what), requiredQuantity: qty })),
  step: [
    ...first.shownWiring.map(([from, to, note]) => ({
      "@type": "HowToStep",
      text: `${t("howtoWire", { from, to })}${note ? ` ${note}` : ""}`,
    })),
    { "@type": "HowToStep", text: t("howtoFlash") },
    { "@type": "HowToStep", text: t("howtoCheck", { baud: p.baud, sample: first.sample.slice(0, 3).join(" / ") }) },
  ],
};

const labExpect = LAB_EXPECT[p.id];
const previewable = Boolean(labExpect && labExpect.needs === "none" && !(labExpect.settings ?? []).length);
const previewBoards = Object.fromEntries(BOARDS.filter((b) => b.id === "esp32" || b.id === "esp32s3" || b.id === "esp32c3").map((b) => [b.id, b.name]));
---

<Base title={t("pageTitle", { name })} description={description} current="library" image={`/og/projects/${p.id}.png`} jsonLd={howTo}>
  <section class="view">
    <a class="back" href={link("/")}>{t("back")}</a>

    <div class="stack tight">
      <h1 class="h2">{name}</h1>
      <p class="lede">{sum}</p>
      <div class="meta">
        <span class="tag lvl">{t(`level.${p.level}`)}</span>
        <span class="tag">{t("mins", { n: p.mins })}</span>
        <span class="tag">{t("baud", { n: p.baud })}</span>
        <span class="tag ok" data-lab-tag hidden title={t("labTagTitle")}>{t("labTested")}</span>
        <button class="btn sm printbtn" type="button" data-print>{t("print")}</button>
        {
          p.code !== undefined && (
            <button
              class="btn sm"
              type="button"
              data-keep-offline
              data-project={p.id}
              data-name={name}
              data-boards={boards.map((b) => b.short).join(", ")}
              hidden
            />
          )
        }
      </div>
      <p class="cap left" data-keep-status role="status" hidden></p>
      {
        p.tags.includes("probeharbor") && (
          <p class="phcredit">
            <Fragment set:html={t(p.probeharbor ? "phFor" : "phFrom", { ph: `<a href="${PROBEHARBOR.url}">ProbeHarbor</a>`, blurb: t("phBlurb") })} />{" "}
            <Fragment
              set:html={
                p.probeharbor === "reads"
                  ? t("phReads", { link: `<a href="${PROBEHARBOR.url}">probeharbor.dev</a>` })
                  : p.probeharbor === "sends"
                    ? t("phSends", { link: `<a href="${PROBEHARBOR.url}">probeharbor.dev</a>` })
                    : `${t("phSends", { link: `<a href="${PROBEHARBOR.url}">probeharbor.dev</a>` })} ${t("phRepo", { repo: `<a href="${PROBEHARBOR.repo}">${t("phRepoName")}</a>` })}`
              }
            />
          </p>
        )
      }
    </div>

    <Preview id={p.id} />

    <div class="stack tight">
      <div class="codehead">
        <h2 class="h3">{t("parts")}</h2>
        <div class="row">
          <button class="btn sm" type="button" id="shop-toggle" data-project={p.id} aria-pressed="false" data-on={t("onShop")} data-off={t("addShop")} data-count={t("shopListCount")}>{t("addShop")}</button>
          <a class="shoplink" href={link("/shop/")} id="shop-link" hidden>{t("shopList")}</a>
        </div>
      </div>
      <div class="cols even">
        <a class="kitcard" href={kitSrc} title={t("kitOpen")}>
          <img src={kitSrc} width="1200" height="630" loading="lazy" decoding="async" alt={kitAlt} />
        </a>
        <div class="stack tight">
          <div class="tablebox">
            <table>
              <thead class="sr">
                <tr>
                  <th>{t("thQty")}</th>
                  <th>{t("thPart")}</th>
                  <th>{t("thBuy")}</th>
                </tr>
              </thead>
              <tbody>
                {p.parts.map(([qty, what], i) => (
                  <tr>
                    <td class="q">{qty}×</td>
                    <td>
                      <div class="partname">
                        <span class="kicon" set:html={kitIconSvg(kit[i], PAGE_PALETTE, 28)} />
                        <span>{tc(what)}</span>
                      </div>
                    </td>
                    <td class="m">{buy[i] && <a href={buy[i].href} rel={buy[i].rel} data-amazon-q={buy[i].amazonQ} target="_blank">{buyText(buy[i].href)}</a>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {
            p.code !== undefined && (
              <p class="libs">
                <span class="swlabel">{t("libraries")}</span> {p.libs.length > 0 ? p.libs.map(libText).join(", ") : t("libsNone")}
              </p>
            )
          }
          {hasBuyLinks && <p class="cap left">{t("affiliate")}</p>}
        </div>
      </div>
    </div>

    {
      boards.length > 1 && (
        <div class="row" id="boardswitch" role="group" aria-label={t("board")}>
          <span class="swlabel">{t("board")}</span>
          {boards.map((b, i) => (
            <button class="chip" type="button" data-board={b.id} aria-pressed={i === 0 ? "true" : "false"} title={b.name}>
              <span class="bname full">{b.name}</span>
              <span class="bname short">{b.short}</span>
            </button>
          ))}
        </div>
      )
    }

    {
      panels.map((panel, i) => (
        <div class="stack" data-panel={panel.board.id} hidden={i !== 0}>
          <div class="cols">
            <Pinout board={panel.board} pins={panel.pins} caption={t("pinCaption", { board: panel.board.name })} />
            <div class="stack">
              <div>
                <h2 class="h3 mb">{t("wiring")}</h2>
                {panel.wiring.length > 0 ? (
                  <div class="tablebox">
                    <table id={`wiring-${panel.board.id}`}>
                      <thead>
                        <tr>
                          <th>{t("thFrom")}</th>
                          <th>{t("thTo")}</th>
                          <th>{t("thNote")}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {panel.shownWiring.map(([from, to, note]) => (
                          <tr>
                            <td>{from}</td>
                            <td class="m">{to}</td>
                            <td>{note}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  <p class="lede">{t("nothingToWire")}</p>
                )}
              </div>
              <WiringDiagram
                rows={panel.wiring}
                shownRows={panel.shownWiring}
                board={panel.board}
                projectId={p.id}
                projectName={name}
                tableId={`wiring-${panel.board.id}`}
                benchHref={benchHref}
                baud={p.baud}
              />
              {panel.verified.length > 0 ? (
                <div>
                  <h2 class="h3 mb">{t("testedHere")}</h2>
                  <ul class="checks">
                    {panel.verified.map((v) => (
                      <li>
                        <span class="tag ok">{t("tested")}</span>
                        <span>{tc(v.what)}{v.when && <span class="when">{` (${v.when})`}</span>}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                // Untested everywhere is said once, under "Not tested yet"; this covers a board the others were tested on.
                (anyVerified || !p.open) && (
                  <div>
                    <h2 class="h3 mb">{t("testedHere")}</h2>
                    <p class="lede">{t("notRunHere")}</p>
                  </div>
                )
              )}
            </div>
          </div>

        </div>
      ))
    }

    {
      p.flash ? (
        <div class="stack tight">
          <h2 class="h3">{t("flashIt")}</h2>
          <Flasher manifest={p.flash.manifest} version={p.flash.version} project={p.id} />
          <ol class="steps">
            {p.flash.after.map((step) => <li>{tc(step)}</li>)}
          </ol>
          {p.setup === "probeharbor" && <ProbeSetup />}
          {p.settings && <SettingsForm settings={p.settings} project={p.id} baud={p.baud} />}
          {p.sourceUrl && <p><a href={p.sourceUrl} rel="noopener noreferrer" target="_blank">{t("fwSource")}</a></p>}
        </div>
      ) : (
        p.code !== undefined && (
          <div class="stack">
            <FirmwareLibrary projectId={p.id} boards={buildChoices(boards)} boardMap={Object.fromEntries(boards.map((b) => [b.id, buildTarget(b)]))} />
            {p.settings && <SettingsForm settings={p.settings} project={p.id} baud={p.baud} />}
            {panels.map((panel, i) => {
              if (panel.code === undefined) return null;
              const lines = panel.code.split("\n").length;
              const clip = lines > CLIP_LINES + 6;
              return (
                <div class="stack tight" data-panel={panel.board.id} hidden={i !== 0}>
                  <div class="codehead">
                    <h2 class="h3">{t("sketchFor", { board: panel.board.arduinoBoard })}</h2>
                    <button class="btn sm" type="button" data-copy data-copied={t("copied")} data-blocked={t("copyBlocked")}>{t("copyFirmware")}</button>
                  </div>
                  <pre class:list={["code", { clip }]} style={clip ? `--clip-lines: ${CLIP_LINES}` : undefined}><code>{panel.code}</code></pre>
                  {clip && (
                    <button class="btn sm unclip" type="button" data-unclip>
                      {t("showWhole", { n: lines })}
                    </button>
                  )}
                  <SketchBuilder
                    mode="project"
                    project={p.id}
                    board={buildTarget(panel.board)}
                    libs={p.libs}
                    hugeApp={COMPILE.hugeApp.includes(p.id)}
                    baud={p.baud}
                    hasSettings={!!p.settings}
                  />
                </div>
              );
            })}
            {p.extraCode && (
              <div class="stack tight" data-code>
                <div class="codehead">
                  <h2 class="h3">{tc(p.extraCode.title)}</h2>
                  <button class="btn sm" type="button" data-copy data-copied={t("copied")} data-blocked={t("copyBlocked")}>{t("copySketch")}</button>
                </div>
                {(() => {
                  const lines = p.extraCode.code.split("\n").length;
                  const clip = lines > CLIP_LINES + 6;
                  return (
                    <>
                      <pre class:list={["code", { clip }]} style={clip ? `--clip-lines: ${CLIP_LINES}` : undefined}><code>{p.extraCode.code}</code></pre>
                      {clip && (
                        <button class="btn sm unclip" type="button" data-unclip>
                          {t("showWhole", { n: lines })}
                        </button>
                      )}
                    </>
                  );
                })()}
              </div>
            )}
            <details class="ide">
              <summary>{t("ideSummary")}</summary>
              <ol class="steps">
                <li>{t("ide1")}</li>
                {needsLibraries && <li>{t("ide2")}</li>}
                <li>{t("ide3")}</li>
                <li>{t("ide4")}</li>
              </ol>
              {p.sourceUrl && <p><a href={p.sourceUrl} rel="noopener noreferrer" target="_blank">{t("sketchSource")}</a></p>}
            </details>
          </div>
        )
      )
    }

    <div class="stack tight nextsteps">
      <h2 class="h3">{t("watch")}</h2>
      <div class="row">
        <a class="btn go" href={benchHref}>{t("openBench", { baud: p.baud })}</a>
        <button
          class="btn"
          type="button"
          id="built"
          data-project={p.id}
          data-board={boards[0].id}
          aria-pressed="false"
          data-mark={t("markBuilt")}
          data-undo={t("builtUndo")}
          data-logged={t("loggedOn")}
          data-sync={t("syncIt")}
          data-sync-href={`${link("/")}#sync`}
        >
          {t("markBuilt")}
        </button>
        <span class="pickresult" id="built-note" role="status"></span>
      </div>
      {
        previewable && (
          <div class="preview stack tight" id="preview" data-src={`${SITE.fwBase}/${p.id}/preview.json`} data-names={JSON.stringify(previewBoards)} hidden>
            <div class="codehead">
              <h3 class="h4">{t("whatPrints")}</h3>
              <div class="row">
                <select id="preview-board" aria-label={t("board")} hidden />
                <button class="btn sm" type="button" id="preview-replay">{t("replay")}</button>
              </div>
            </div>
            <div class="term previewterm" id="preview-term" role="log" aria-label={t("serialRecorded")} />
            <p class="cap left" id="preview-note" />
          </div>
        )
      }
      {
        onPaths.map((path) => (
          <p class="pathnote">
            <Fragment set:html={t("pathStep", { step: path.step, of: path.of, path: `<a href="${link("/")}#paths">${path.name}</a>` })} />
            {path.next ? (
              <>
                {" "}
                <Fragment set:html={t("pathNext", { next: `<a href="${link(`/projects/${path.next.id}/`)}">${escapeHtml(tc(path.next.name))}</a>` })} />
              </>
            ) : (
              ` ${t("pathLast")}`
            )}
          </p>
        ))
      }
    </div>

    {
      p.notes && (
        <div>
          <h2 class="h3 mb">{t("fieldNotes")}</h2>
          <ul class="notes">
            {p.notes.map((n) => <li>{tc(n)}</li>)}
          </ul>
        </div>
      )
    }

    {
      p.open && (
        <div>
          <h2 class="h3 mb">{t("notTested")}</h2>
          <ul class="notes">
            {p.open.map((n) => <li>{tc(n)}</li>)}
          </ul>
        </div>
      )
    }

    <div class="stack tight band" id="community" data-builds={SITE.buildsApi} data-project={p.id}>
      <h2>{t("community")}</h2>
      <p class="lede" data-community-status>
        {t("communityLoading")}{" "}
        {buildReportUrl && <Fragment set:html={t("builtItLink", { link: `<a href="${escapeHtml(buildReportUrl)}">${t("sendReport")}</a>` })} />}
      </p>
      <div class="labrun" data-lab hidden></div>
      <ul class="builds" data-community-list hidden></ul>
    </div>

    <Comments />
  </section>
</Base>

<style>
  .kitcard { display: block; margin: 0 0 12px; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: #f2f5f1; }
  .kitcard img { display: block; width: 100%; height: auto; }
  .partname { display: flex; gap: 10px; align-items: center; }
  .kicon { flex: none; display: inline-flex; width: 28px; height: 28px; color: var(--ink); }
  .kicon :global(svg) { width: 28px; height: 28px; }
  .phcredit { padding: 10px 12px; background: var(--panel); border: 1px solid var(--line); border-left: 4px solid var(--ok); font-size: 0.92rem; max-width: 75ch; }
  .phcredit a { color: var(--accent); }
  .labrun { display: flex; flex-direction: column; gap: 8px; padding: 12px; background: var(--panel); border: 1px solid var(--line); border-left: 4px solid var(--ok); min-width: 0; }
  .labrun :global(.labhead) { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .labrun :global(.labwhen) { font: 400 0.8rem/1.2 var(--mono); color: var(--muted); margin-left: auto; }
  .labrun :global(details) { font-size: 0.88rem; }
  .labrun :global(summary) { cursor: pointer; color: var(--muted); }
  .labrun :global(pre.code) { margin-top: 6px; max-height: 18em; }
  .labrun :global(.tag.pending) { border-style: dashed; }
  .libs { margin: 0; font-size: 0.92rem; }
  .printbtn { margin-left: auto; }
  .shoplink { font-size: 0.85rem; color: var(--accent); }
  .pathnote { margin: 0; font-size: 0.9rem; }
  .pathnote a { color: var(--accent); }
  pre.code.clip { max-height: calc(var(--clip-lines) * 1.55em + 14px); overflow: hidden; mask-image: linear-gradient(to bottom, #000 75%, transparent); }
  .unclip { align-self: flex-start; }
  details.ide { background: var(--panel); border: 1px solid var(--line); padding: 10px 14px; }
  details.ide summary { cursor: pointer; font-weight: 600; }
  details.ide[open] summary { margin-bottom: 10px; }
  details.ide p { margin: 10px 0 0; }
  .nextsteps { padding: 14px; border: 1px solid var(--line); border-left: 4px solid var(--accent); background: var(--panel); }
</style>

<script>
  import "../../../scripts/community.ts";
</script>

<script>
  import { loadBuilt, loadShop, saveBuilt, saveShop } from "../../../scripts/progress";
  import { loadState as loadSyncState } from "../../../scripts/sync";
  import "../../../scripts/preview.ts";

  // Board switcher: one pre-rendered panel per board, one visible at a time.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("#boardswitch [data-board]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];

  function show(board: string) {
    if (!panels.some((p) => p.dataset.panel === board)) return;
    for (const p of panels) p.hidden = p.dataset.panel !== board;
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.board === board));
  }
  for (const b of buttons) {
    b.addEventListener("click", () => {
      const board = b.dataset.board ?? "";
      show(board);
      try {
        localStorage.setItem("bench.board", board);
      } catch {
        // Remembering the board is a convenience only.
      }
    });
  }
  try {
    const saved = localStorage.getItem("bench.board");
    if (saved) show(saved);
  } catch {
    // Storage unavailable: stay on the first board.
  }

  // Build log: remember that this project worked, and on which board.
  const builtBtn = document.getElementById("built") as HTMLButtonElement;
  const builtNote = document.getElementById("built-note") as HTMLElement;
  const projectId = builtBtn.dataset.project ?? "";
  const currentBoard = () =>
    buttons.find((b) => b.getAttribute("aria-pressed") === "true")?.dataset.board ?? builtBtn.dataset.board ?? "";

  function showBuilt() {
    const mark = loadBuilt()[projectId];
    builtBtn.setAttribute("aria-pressed", String(Boolean(mark)));
    builtBtn.textContent = (mark ? builtBtn.dataset.undo : builtBtn.dataset.mark) ?? "";
    builtNote.textContent = mark ? (builtBtn.dataset.logged ?? "").replace("{date}", new Date(mark.at).toLocaleDateString(document.documentElement.lang || undefined)) : "";
    if (mark && !loadSyncState()) {
      const a = document.createElement("a");
      a.href = builtBtn.dataset.syncHref ?? "/#sync";
      a.textContent = builtBtn.dataset.sync ?? "";
      builtNote.append(" ", a);
    }
  }
  builtBtn.addEventListener("click", () => {
    const all = loadBuilt();
    if (all[projectId]) delete all[projectId];
    else all[projectId] = { at: new Date().toISOString(), board: currentBoard() };
    saveBuilt(all);
    showBuilt();
  });
  showBuilt();

  // Shopping list: add or remove this project.
  const shopBtn = document.getElementById("shop-toggle") as HTMLButtonElement | null;
  const shopLink = document.getElementById("shop-link");
  function showShop() {
    if (!shopBtn) return;
    const list = loadShop();
    const on = list.includes(shopBtn.dataset.project ?? "");
    shopBtn.setAttribute("aria-pressed", String(on));
    shopBtn.textContent = (on ? shopBtn.dataset.on : shopBtn.dataset.off) ?? "";
    if (shopLink) {
      shopLink.hidden = list.length === 0;
      shopLink.textContent = (shopBtn.dataset.count ?? "").replace("{n}", String(list.length));
    }
  }
  shopBtn?.addEventListener("click", () => {
    const id = shopBtn.dataset.project ?? "";
    const list = loadShop();
    saveShop(list.includes(id) ? list.filter((x) => x !== id) : [...list, id]);
    showShop();
  });
  showShop();

  // Print build sheet: the Arduino IDE steps are folded on screen but belong on paper.
  const ide = document.querySelector<HTMLDetailsElement>("details.ide");
  let ideWasOpen = false;
  window.addEventListener("beforeprint", () => {
    ideWasOpen = ide?.open ?? false;
    if (ide) ide.open = true;
  });
  window.addEventListener("afterprint", () => {
    if (ide) ide.open = ideWasOpen;
  });
  document.querySelector("[data-print]")?.addEventListener("click", () => window.print());

  // Long sketches start clipped; the button shows the rest.
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-unclip]")) {
    btn.addEventListener("click", () => {
      btn.closest("[data-panel], [data-code]")?.querySelector("pre.code")?.classList.remove("clip");
      btn.hidden = true;
    });
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    btn.addEventListener("click", async () => {
      const label = btn.textContent;
      const code = btn.closest("[data-code], [data-panel]")?.querySelector("pre.code code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = btn.dataset.copied ?? "";
      } catch {
        btn.textContent = btn.dataset.blocked ?? "";
      }
      setTimeout(() => {
        btn.textContent = label;
      }, 1600);
    });
  }
</script>
