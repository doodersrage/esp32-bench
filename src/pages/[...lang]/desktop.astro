---
import { localePaths } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
import { DESKTOP } from "../../lib/site";
import { DESKTOP_STRINGS } from "../../i18n/strings/desktop";
import { translator } from "../../i18n/t";

const t = translator(DESKTOP_STRINGS, Astro.currentLocale);
const repo = `<a href="${DESKTOP.repo}">GitHub</a>`;
// One example file per package manager for the install commands.
const pick = (distro: string) => DESKTOP.packages.find((p) => p.distro === distro)!;
const arch = pick("Arch Linux");
const ubuntu = pick("Ubuntu 26.04 LTS");
const fedora = pick("Fedora 45");
// A download link to one of the release's files, for the Windows and macOS paragraphs.
const file = (name: string) => `<a href="${DESKTOP.download}${name}"><code>${name}</code></a>`;

// The desktop app: what it is, who it is for, how to install it. Linked from the
// footer and from "Open in the desktop app" on project pages.
export const getStaticPaths = localePaths;
---

<Base title={t("title")} current="none" description={t("description")}>
  <section class="view prose">
    <h1 class="h2">{t("h1")}</h1>
    <p class="lede">{t("lede")}</p>

    <figure class="shot">
      <a href="/screenshots/desktop-library.webp"><img src="/screenshots/desktop-library.webp" width="2131" height="1080" loading="lazy" decoding="async" alt={t("shotLibrary")} /></a>
      <figcaption>{t("shotLibrary")}</figcaption>
    </figure>

    <h2>{t("doesH")}</h2>
    <ul>
      <li>{t("doesBuild")}</li>
      <li>{t("doesFlash")}</li>
      <li>{t("doesSim")}</li>
      <li>{t("doesWifi")}</li>
      <li>{t("doesTrace")}</li>
      <li>{t("doesLanguages")}</li>
    </ul>

    <figure class="shot">
      <a href="/screenshots/desktop-simulator.webp"><img src="/screenshots/desktop-simulator.webp" width="2131" height="1080" loading="lazy" decoding="async" alt={t("shotSim")} /></a>
      <figcaption>{t("shotSim")}</figcaption>
    </figure>

    <figure class="shot">
      <a href="/screenshots/desktop-debugger.webp"><img src="/screenshots/desktop-debugger.webp" width="2131" height="1080" loading="lazy" decoding="async" alt={t("shotDebug")} /></a>
      <figcaption>{t("shotDebug")}</figcaption>
    </figure>

    <h2>{t("limitsH")}</h2>
    <ul>
      <li>{t("limitsPlatform")}</li>
      <li>{t("limitsSim")}</li>
      <li>{t("limitsReset")}</li>
    </ul>

    <h2>{t("installH")}</h2>
    <p set:html={t("install", { version: `<a href="${DESKTOP.release}">${DESKTOP.version}</a>` })} />
    <h3>Windows</h3>
    <p set:html={t("installWindows", { installer: file(DESKTOP.windows.installer), zip: file(DESKTOP.windows.zip) })} />
    <h3>macOS</h3>
    <p set:html={t("installMac", { dmg: file(DESKTOP.macos) })} />
    <h3>Linux</h3>
    <p>{t("installLinux")}</p>
    <ul>
      {DESKTOP.packages.map((p) => <li>{p.distro}: <a href={DESKTOP.download + p.file}><code>{p.file}</code></a></li>)}
    </ul>
    <p>{t("installCommand")}</p>
    <pre class="code"><code>sudo pacman -U ./{arch.file}
sudo apt install ./{ubuntu.file}
sudo dnf install ./{fedora.file}</code></pre>
    <p>{t("installAfter")}</p>

    <h2>{t("openH")}</h2>
    <p>{t("open")}</p>

    <h2>{t("sourceH")}</h2>
    <p set:html={t("source", { repo })} />
  </section>
</Base>
