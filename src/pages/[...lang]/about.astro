---
import { localePaths } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
import { localLink } from "../../lib/paths";
import { PROBEHARBOR, SITE } from "../../lib/site";
import { ABOUT } from "../../i18n/strings/pages";
import { SHELL } from "../../i18n/strings/shell";
import { translator } from "../../i18n/t";
import { PROJECTS } from "../../data/projects";

const link = localLink(Astro.currentLocale);
const t = translator(ABOUT, Astro.currentLocale);
const shell = translator(SHELL, Astro.currentLocale);

const tested = PROJECTS.filter((p) => (p.verified ?? []).length > 0).length;

export const getStaticPaths = localePaths;
---

<Base title={t("title")} current="about" description={t("description")}>
  <section class="view prose">
    <h1 class="h2">{t("h1")}</h1>
    <p class="lede">{t("lede")}</p>

    <h2>{t("whoH")}</h2>
    <p set:html={t("who", { authorUrl: SITE.author.url, author: SITE.author.name, probeUrl: PROBEHARBOR.url })} />

    <h2>{t("testedH")}</h2>
    <p>{t(tested === 1 ? "testedOne" : "testedMany", { tested, total: PROJECTS.length })}</p>

    <h2>{t("storedH")}</h2>
    <p>{t("stored")}</p>

    <h2 id="affiliate">{t("buyH")}</h2>
    <p>{t("disclosure")} {t("buy")}</p>

    <h2>{t("browsersH")}</h2>
    <p set:html={t("browsers", { start: link("/start/") })} />

    <h2>{t("installH")}</h2>
    <p>{t("install", { install: shell("install") })}</p>

    <h2>{t("probeH")}</h2>
    <p set:html={t("probe", { probeUrl: PROBEHARBOR.url, probeRepo: PROBEHARBOR.repo })} />

    <h2>{t("sourceH")}</h2>
    <p set:html={t("source", { repo: SITE.repo, discussions: `https://github.com/${SITE.giscus.repo}/discussions` })} />

    <h2>{t("licenseH")}</h2>
    <p set:html={t("license")} />

    <h2>{t("safetyH")}</h2>
    <p>{t("safety")}</p>

    <h2>{t("contactH")}</h2>
    <p set:html={t("contact", { mistake: shell("footMistake"), form: link("/report/?kind=message") })} />

    {
      SITE.giscus.enabled && SITE.giscus.categoryId && (
        <>
          <h2>{t("commentsH")}</h2>
          <p>{t("comments")}</p>
        </>
      )
    }

    <p class="when" set:html={t("history", { changes: link("/changes/") })} />
  </section>
</Base>
