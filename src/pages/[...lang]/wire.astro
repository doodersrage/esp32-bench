---
import { localePaths } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
import { HEADER_BOARDS } from "../../data/boards";
import { PARTS } from "../../data/parts";
import { DRAWER_GROUPS, PROJECTS } from "../../data/projects";
import { translator } from "../../i18n/t";
import { contentTranslator } from "../../i18n/content";
import { PART_GROUPS, PART_NAMES, WIRE, byEnglish } from "../../i18n/strings/bench";

const t = translator(WIRE, Astro.currentLocale);
const tc = contentTranslator(Astro.currentLocale);
const partNames = translator(PART_NAMES, Astro.currentLocale);
const partName = (p: { id: string; name: string }) => (p.id in PART_NAMES.en ? partNames(p.id as keyof typeof PART_NAMES.en) : p.name);

const remixable = PROJECTS.filter((p) => p.needs.length > 0);
// The pad's parts in the same groups as the library's parts drawer (the ids are shared).
const partGroups = DRAWER_GROUPS.map(([label, ids]) => [label, PARTS.filter((p) => ids.includes(p.id))] as const).filter(([, parts]) => parts.length > 0);
const ungroupedParts = PARTS.filter((p) => !DRAWER_GROUPS.some(([, ids]) => ids.includes(p.id)));
if (ungroupedParts.length) throw new Error(`Wire parts missing from DRAWER_GROUPS: ${ungroupedParts.map((p) => p.id).join(", ")}`);
const needsAttr = (needs: string[][]) => needs.map((group) => group.join("|")).join(" ");

export const getStaticPaths = localePaths;
---

<Base
  title={t("title")}
  current="wire"
  description={t("description")}
>
  <section class="view">
    <h1 class="h2">{t("heading")}</h1>
    <p class="lede">{t("lede")}</p>

    <div class="row" id="w-boards" role="group" aria-label={t("board")}>
      <span class="swlabel">{t("board")}</span>
      {
        HEADER_BOARDS.map((b) => (
          <button class="chip" type="button" data-board={b.id} aria-pressed={b.id === "esp32" ? "true" : "false"} title={b.name}>
            <span class="bname full">{b.name}</span>
            <span class="bname short">{b.short}</span>
          </button>
        ))
      }
    </div>

    <details class="drawer" id="w-partsbox" open>
      <summary>{t("parts")}<span class="partsum" id="w-partsum"></span></summary>
      <div id="w-parts" role="group" aria-label={t("parts")}>
        {
          partGroups.map(([label, parts]) => (
            <div class="partgroup">
              <h2 class="partlabel">{byEnglish(PART_GROUPS, label, Astro.currentLocale)}</h2>
              <div class="row">
                {parts.map((p) => (
                  <button class="chip" type="button" data-part={p.id} aria-pressed="false">
                    {partName(p)}
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </details>

    <div class="cols">
      <figure class="fig">
        <div id="w-board"></div>
        <figcaption>{t("figcaption")}</figcaption>
      </figure>
      <div class="stack">
        <div class="stack tight">
          <h2 class="h3">{t("partPins")}</h2>
          <div class="stack tight" id="w-pins"></div>
          <p class="pickresult" id="w-status" role="status"></p>
          <div class="row">
            <button class="btn go" type="button" id="w-auto">{t("wireForMe")}</button>
            <button class="btn" type="button" id="w-clear">{t("clearWires")}</button>
          </div>
        </div>
        <div class="stack tight">
          <h2 class="h3">{t("checks")}</h2>
          <ul class="findings" id="w-findings"></ul>
        </div>
      </div>
    </div>

    <div class="cols even">
      <div class="stack tight">
        <h2 class="h3">{t("wiring")}</h2>
        <div class="tablebox">
          <table>
            <thead>
              <tr>
                <th>{t("from")}</th>
                <th>{t("toBoard")}</th>
              </tr>
            </thead>
            <tbody id="w-table"></tbody>
          </table>
        </div>
      </div>
      <div class="stack tight">
        <div class="codehead">
          <h2 class="h3">{t("pinConstants")}</h2>
          <button class="btn sm" type="button" id="w-copy">{t("copyWiring")}</button>
        </div>
        <pre class="code" id="w-code"></pre>
      </div>
    </div>

    <div class="stack tight band">
      <h2>{t("remixTitle")}</h2>
      <p class="lede">{t("remixLede")}</p>
      <div class="row">
        <select id="remix-a" aria-label={t("firstProject")}>
          {remixable.map((p) => <option value={p.id} data-needs={needsAttr(p.needs)} selected={p.id === "dht22"}>{tc(p.name)}</option>)}
        </select>
        <span class="swlabel">{t("plus")}</span>
        <select id="remix-b" aria-label={t("secondProject")}>
          {remixable.map((p) => <option value={p.id} data-needs={needsAttr(p.needs)} selected={p.id === "oled"}>{tc(p.name)}</option>)}
        </select>
        <button class="btn" type="button" id="remix-go">{t("remix")}</button>
      </div>
      <p class="pickresult" id="remix-note" role="status"></p>
    </div>
  </section>
</Base>

<script>
  import "../../scripts/wire.ts";
  import { pageLocale, translator } from "../../i18n/t";
  import { WIRE } from "../../i18n/strings/bench";

  const t = translator(WIRE, pageLocale());

  // The parts list is long: on phones it starts folded, and its summary names what is on the pad.
  const box = document.getElementById("w-partsbox") as HTMLDetailsElement | null;
  const sum = document.getElementById("w-partsum");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("#w-parts [data-part]")];
  const describe = () => {
    const picked = chips.filter((c) => c.getAttribute("aria-pressed") === "true").map((c) => c.textContent?.trim() ?? "");
    if (sum) sum.textContent = picked.length ? t("partsumList", { list: picked.join(", ") }) : t("partsumNone");
  };
  if (box && window.matchMedia("(max-width: 720px)").matches) box.open = false;
  describe();
  const watch = new MutationObserver(describe);
  for (const chip of chips) watch.observe(chip, { attributes: true, attributeFilter: ["aria-pressed"] });
</script>
