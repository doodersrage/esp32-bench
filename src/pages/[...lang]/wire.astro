---
import { localePaths } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
import { HEADER_BOARDS } from "../../data/boards";
import { PARTS } from "../../data/parts";
import { DRAWER_GROUPS, PROJECTS } from "../../data/projects";

const remixable = PROJECTS.filter((p) => p.needs.length > 0);
// The pad's parts in the same groups as the library's parts drawer (the ids are shared).
const partGroups = DRAWER_GROUPS.map(([label, ids]) => [label, PARTS.filter((p) => ids.includes(p.id))] as const).filter(([, parts]) => parts.length > 0);
const ungroupedParts = PARTS.filter((p) => !DRAWER_GROUPS.some(([, ids]) => ids.includes(p.id)));
if (ungroupedParts.length) throw new Error(`Wire parts missing from DRAWER_GROUPS: ${ungroupedParts.map((p) => p.id).join(", ")}`);
const needsAttr = (needs: string[][]) => needs.map((group) => group.join("|")).join(" ");

export const getStaticPaths = localePaths;
---

<Base
  title="ESP32 wiring checker"
  current="wire"
  description="Wire sensors and displays to an ESP32 on screen. Every wire is checked for boot pins, input-only pins, 5 V signals and clashes, and two projects can be remixed onto one board."
>
  <section class="view">
    <h1 class="h2">Wiring pad</h1>
    <p class="lede">
      Choose a board and parts, then tap a part pin and a board pad to join them. Each wire is checked for boot pins,
      input-only pins, 5 V signals and pads used twice.
    </p>

    <div class="row" id="w-boards" role="group" aria-label="Board">
      <span class="swlabel">Board</span>
      {
        HEADER_BOARDS.map((b) => (
          <button class="chip" type="button" data-board={b.id} aria-pressed={b.id === "esp32" ? "true" : "false"} title={b.name}>
            <span class="bname full">{b.name}</span>
            <span class="bname short">{b.short}</span>
          </button>
        ))
      }
    </div>

    <details class="drawer" id="w-partsbox" open>
      <summary>Parts<span class="partsum" id="w-partsum"></span></summary>
      <div id="w-parts" role="group" aria-label="Parts">
        {
          partGroups.map(([label, parts]) => (
            <div class="partgroup">
              <h2 class="partlabel">{label}</h2>
              <div class="row">
                {parts.map((p) => (
                  <button class="chip" type="button" data-part={p.id} aria-pressed="false">
                    {p.name}
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </details>

    <div class="cols">
      <figure class="fig">
        <div id="w-board"></div>
        <figcaption>Tap a pad to connect the selected pin. Pads with a dashed ring need care.</figcaption>
      </figure>
      <div class="stack">
        <div class="stack tight">
          <h2 class="h3">Part pins</h2>
          <div class="stack tight" id="w-pins"></div>
          <p class="pickresult" id="w-status" role="status"></p>
          <div class="row">
            <button class="btn go" type="button" id="w-auto">Wire it for me</button>
            <button class="btn" type="button" id="w-clear">Clear wires</button>
          </div>
        </div>
        <div class="stack tight">
          <h2 class="h3">Checks</h2>
          <ul class="findings" id="w-findings"></ul>
        </div>
      </div>
    </div>

    <div class="cols even">
      <div class="stack tight">
        <h2 class="h3">Wiring</h2>
        <div class="tablebox">
          <table>
            <thead>
              <tr>
                <th>From</th>
                <th>To board</th>
              </tr>
            </thead>
            <tbody id="w-table"></tbody>
          </table>
        </div>
      </div>
      <div class="stack tight">
        <div class="codehead">
          <h2 class="h3">Pin constants</h2>
          <button class="btn sm" type="button" id="w-copy">Copy wiring</button>
        </div>
        <pre class="code" id="w-code"></pre>
      </div>
    </div>

    <div class="stack tight band">
      <h2>Remix two projects</h2>
      <p class="lede">Pick two projects to load their parts onto one board, wired so nothing shares a pin it should not.</p>
      <div class="row">
        <select id="remix-a" aria-label="First project">
          {remixable.map((p) => <option value={p.id} data-needs={needsAttr(p.needs)} selected={p.id === "dht22"}>{p.name}</option>)}
        </select>
        <span class="swlabel">plus</span>
        <select id="remix-b" aria-label="Second project">
          {remixable.map((p) => <option value={p.id} data-needs={needsAttr(p.needs)} selected={p.id === "oled"}>{p.name}</option>)}
        </select>
        <button class="btn" type="button" id="remix-go">Remix</button>
      </div>
      <p class="pickresult" id="remix-note" role="status"></p>
    </div>
  </section>
</Base>

<script>
  import "../../scripts/wire.ts";

  // The parts list is long: on phones it starts folded, and its summary names what is on the pad.
  const box = document.getElementById("w-partsbox") as HTMLDetailsElement | null;
  const sum = document.getElementById("w-partsum");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("#w-parts [data-part]")];
  const describe = () => {
    const picked = chips.filter((c) => c.getAttribute("aria-pressed") === "true").map((c) => c.textContent?.trim() ?? "");
    if (sum) sum.textContent = picked.length ? `: ${picked.join(", ")}` : ": none yet";
  };
  if (box && window.matchMedia("(max-width: 720px)").matches) box.open = false;
  describe();
  const watch = new MutationObserver(describe);
  for (const chip of chips) watch.observe(chip, { attributes: true, attributeFilter: ["aria-pressed"] });
</script>
