---
import { localePaths } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
import { PROJECTS } from "../../data/projects";
import { BOARDS } from "../../data/boards";
import { SITE } from "../../lib/site";
import { localLink } from "../../lib/paths";
import { REPORT } from "../../i18n/strings/pages";
import { translator } from "../../i18n/t";

const link = localLink(Astro.currentLocale);
const t = translator(REPORT, Astro.currentLocale);

const projects = [...PROJECTS].sort((a, b) => a.name.localeCompare(b.name));

export const getStaticPaths = localePaths;
---

<Base title={t("title")} current="report" description={t("description")}>
  <section class="view">
    <div class="stack tight">
      <h1 class="h2">{t("h1")}</h1>
      <p class="lede">{t("lede")}</p>
    </div>

    <form class="reportform" id="report" data-api={SITE.reportApi} data-sitekey={SITE.turnstileSitekey} novalidate>
      <fieldset class="kinds">
        <legend>{t("kindLegend")}</legend>
        <label><input type="radio" name="kind" value="build" checked /> {t("kindBuild")}</label>
        <label><input type="radio" name="kind" value="correction" /> {t("kindCorrection")}</label>
        <label><input type="radio" name="kind" value="message" /> {t("kindMessage")}</label>
      </fieldset>

      <div class="grid2" data-for="build">
        <label>
          {t("project")}
          <select name="project" required>
            <option value="">{t("chooseProject")}</option>
            {projects.map((p) => <option value={p.id}>{p.name}</option>)}
          </select>
        </label>
        <label>
          {t("board")}
          <select name="board" required>
            <option value="">{t("chooseBoard")}</option>
            {BOARDS.map((b) => <option value={b.name}>{b.name}</option>)}
            <option value="Another board">{t("anotherBoard")}</option>
          </select>
        </label>
        <label>
          {t("boardDetail")} <span class="opt">{t("optional")}</span>
          <input name="boardDetail" maxlength="60" placeholder={t("boardDetailPh")} />
        </label>
        <label>
          {t("core")} <span class="opt">{t("optional")}</span>
          <input name="core" maxlength="40" placeholder={t("corePh")} />
        </label>
        <label class="wide">
          {t("result")}
          <select name="result" required>
            <option value="">{t("chooseOne")}</option>
            <option value="Yes, as described">{t("resultYes")}</option>
            <option value="Yes, after a change (described below)">{t("resultChanged")}</option>
            <option value="No">{t("resultNo")}</option>
          </select>
        </label>
        <label class="wide">
          {t("output")} <span class="opt">{t("outputOpt")}</span>
          <textarea name="output" rows="6" maxlength="6000" spellcheck="false"></textarea>
        </label>
      </div>

      <fieldset class="publish" data-for="build">
        <legend>{t("publishLegend")}</legend>
        <label class="check">
          <input type="checkbox" name="publish" />
          {t("publishCheck")}
        </label>
        <label>
          {t("publicName")} <span class="opt">{t("publicNameOpt")}</span>
          <input name="publicName" maxlength="40" autocomplete="nickname" />
        </label>
        <p class="opt">{t("publishNote")}</p>
      </fieldset>

      <label class="wide" data-for="correction">
        {t("page")}
        <input name="page" maxlength="300" placeholder="https://esp32bench.dev/..." />
      </label>

      <label class="wide">
        <span data-label="build">{t("notesBuild")} <span class="opt">{t("optional")}</span></span>
        <span data-label="correction" hidden>{t("notesCorrection")}</span>
        <span data-label="message" hidden>{t("notesMessage")}</span>
        <textarea name="notes" rows="6" maxlength="4000"></textarea>
      </label>

      <div class="grid2">
        <label>
          {t("name")} <span class="opt">{t("optional")}</span>
          <input name="name" maxlength="80" autocomplete="name" />
        </label>
        <label>
          {t("email")} <span class="opt">{t("emailOpt")}</span>
          <input name="email" type="email" maxlength="120" autocomplete="email" />
        </label>
      </div>

      <!-- Left empty by people; bots fill it in. Hidden from people, so not translated. -->
      <div class="hp" aria-hidden="true">
        <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div id="human" class="human"></div>

      <div class="row">
        <button class="btn go" type="submit" id="send">{t("send")}</button>
        <span class="status-msg" id="report-status" role="status" aria-live="polite"></span>
      </div>
    </form>

    <div class="thanks" id="thanks" hidden tabindex="-1">
      <h2>{t("thanksH")}</h2>
      <p set:html={t("thanks", { home: link("/") })} />
    </div>
  </section>
</Base>

<style>
  .reportform { display: flex; flex-direction: column; gap: 14px; max-width: 760px; }
  .reportform label { display: flex; flex-direction: column; gap: 4px; font-size: 0.88rem; font-weight: 500; }
  .reportform input, .reportform select, .reportform textarea {
    padding: 8px 10px; border: 1px solid var(--line); background: var(--panel); border-radius: 2px; font: inherit; font-weight: 400; min-width: 0;
  }
  .reportform textarea { font-family: var(--mono); font-size: 0.85rem; resize: vertical; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 14px; }
  .grid2 .wide { grid-column: 1 / -1; }
  .opt { font-weight: 400; color: var(--muted); }
  .kinds { border: 1px solid var(--line); padding: 10px 12px; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .kinds legend { font: 600 0.72rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 0 4px; }
  .kinds label { flex-direction: row; align-items: center; gap: 6px; font-size: 0.95rem; }
  .human { min-height: 65px; }
  .publish { border: 1px solid var(--line); margin: 0; padding: 10px 12px; display: flex; flex-direction: column; gap: 10px; }
  .publish legend { font: 600 0.72rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 0 4px; }
  .reportform label.check { flex-direction: row; align-items: flex-start; gap: 8px; font-weight: 400; }
  .reportform label.check input { margin-top: 4px; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .status-msg { font-size: 0.92rem; font-weight: 500; }
  .status-msg.bad { color: var(--accent); }
  .thanks { padding: 16px; background: var(--panel); border: 1px solid var(--ok); border-left-width: 4px; display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
  .thanks a { color: var(--accent); }
</style>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script>
  import "../../scripts/report.ts";
</script>
