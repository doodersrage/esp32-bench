---
import { localePaths } from "../../i18n/locales";
// Shopping list: the parts for the projects you picked, merged into one list.
// Everything is rendered as data here; the list itself lives in this browser.
import Base from "../../layouts/Base.astro";
import { PROJECTS } from "../../data/projects";
import { kitFor } from "../../lib/kit";
import { affiliateDisclosure, buyFor } from "../../lib/shop";
import { localLink } from "../../lib/paths";
import { translator } from "../../i18n/t";
import { contentTranslator } from "../../i18n/content";
import { SHOP } from "../../i18n/strings/home";

const link = localLink(Astro.currentLocale);
const t = translator(SHOP, Astro.currentLocale);
const tc = contentTranslator(Astro.currentLocale);

const data = PROJECTS.map((p) => {
  const kit = kitFor(p.parts);
  return {
    id: p.id,
    name: tc(p.name),
    url: link(`/projects/${p.id}/`),
    items: p.parts.map(([qty, text], i) => {
      const buy = buyFor(p.parts[i], Astro.currentLocale);
      return {
        // Parts merge by their English name; `label` is what the page shows.
        key: kit[i].label.toLowerCase(),
        label: tc(kit[i].label),
        qty,
        text: tc(text),
        optional: kit[i].optional,
        alternative: kit[i].alternative,
        href: buy?.href ?? "",
        rel: buy?.rel ?? "",
        buy: buy?.text ?? "",
        search: buy?.search ?? false,
        amazonQ: buy?.amazonQ ?? "",
      };
    }),
  };
});

export const getStaticPaths = localePaths;
---

<Base
  title={t("title")}
  current="library"
  description={t("description")}
>
  <section class="view">
    <a class="back" href={link("/")}>{t("back")}</a>
    <div class="stack tight">
      <h1 class="h2">{t("title")}</h1>
      <p class="lede">{t("lede")}</p>
    </div>

    <div class="row">
      <label class="pick">
        <span class="sr">{t("addLabel")}</span>
        <select id="shop-add">
          <option value="">{t("addOption")}</option>
          {PROJECTS.map((p) => <option value={p.id}>{tc(p.name)}</option>)}
        </select>
      </label>
      <button class="btn sm" type="button" id="shop-clear">{t("clear")}</button>
    </div>

    <ul id="shop-projects"></ul>
    <p class="lede" id="shop-empty">{t("empty")}</p>

    <div class="stack tight" id="shop-parts" hidden>
      <div class="codehead">
        <h2 class="h3">{t("partsHead")}</h2>
        <div class="row">
          <button class="btn sm" type="button" id="shop-copy">{t("copy")}</button>
          <button class="btn sm" type="button" id="shop-print">{t("print")}</button>
          <a class="btn sm" href={link("/#sync")} id="shop-phone">{t("phone")}</a>
        </div>
      </div>
      <fieldset class="shopmode">
        <legend class="sr">{t("quantities")}</legend>
        <label><input type="radio" name="shop-mode" value="reuse" checked /> {t("modeReuse")}</label>
        <label><input type="radio" name="shop-mode" value="all" /> {t("modeAll")}</label>
      </fieldset>
      <div class="tablebox">
        <table>
          <thead>
            <tr><th>{t("thQty")}</th><th>{t("thPart")}</th><th>{t("thFor")}</th><th><span class="sr">{t("thBuy")}</span></th></tr>
          </thead>
          <tbody id="shop-rows"></tbody>
        </table>
      </div>
      <p class="cap left">{t("note")}</p>
      <p class="cap left">{affiliateDisclosure(Astro.currentLocale)}</p>
    </div>
  </section>
</Base>

<script id="shop-data" type="application/json" set:html={JSON.stringify(data)} />

<style is:global>
  /* Global: the list items and table rows are created by scripts/shop.ts. */
  #shop-projects { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  #shop-projects li { display: inline-flex; align-items: center; gap: 6px; padding: 4px 4px 4px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); font-size: 0.88rem; }
  #shop-projects a { color: var(--ink); }
  #shop-projects button { border: 0; background: none; cursor: pointer; color: var(--muted); font-size: 1rem; line-height: 1; padding: 2px 6px; }
  .shopmode { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.9rem; }
  .shopmode label { display: inline-flex; gap: 6px; align-items: center; }
  #shop-rows .opt { font: 500 0.7rem/1 var(--mono); color: var(--muted); text-transform: uppercase; margin-left: 8px; }
  #shop-rows .for { font-size: 0.82rem; color: var(--muted); }
  #shop-rows a { color: var(--accent); white-space: nowrap; }
  @media print {
    #shop-add, #shop-clear, #shop-copy, #shop-print, #shop-phone, .shopmode, #shop-projects button { display: none !important; }
  }
</style>

<script>
  import "../../scripts/shop.ts";
</script>
