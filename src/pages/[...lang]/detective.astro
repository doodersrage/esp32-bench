---
import { localePaths } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
import { localLink } from "../../lib/paths";
import Flasher from "../../components/Flasher.astro";
import { HEADER_BOARDS } from "../../data/boards";
import { CHIPS } from "../../data/chips";
import { DETECTIVE_CHIPS } from "../../lib/detective";
import { translator } from "../../i18n/t";
import { DETECTIVE } from "../../i18n/strings/bench";

const t = translator(DETECTIVE, Astro.currentLocale);

const link = localLink(Astro.currentLocale);

const boards = HEADER_BOARDS.filter((b) => DETECTIVE_CHIPS.includes(b.chip));
const chipList = DETECTIVE_CHIPS.map((c) => CHIPS[c].name);
const families = `${chipList.slice(0, -1).join(", ")}${t("and")}${chipList.at(-1)}`;

export const getStaticPaths = localePaths;
---

<Base
  title={t("title")}
  current="detective"
  description={t("description")}
>
  <section class="view">
    <a class="back" href={link("/tools/")}>{t("back")}</a>
    <h1 class="h2">{t("heading")}</h1>
    <p class="lede">{t("lede", { families })}</p>

    <div class="stack tight">
      <h2 class="h3">{t("step1")}</h2>
      <Flasher manifest="/firmware/pin-detective/manifest.json" version="0.1.0" families={families} />
      <p class="cap left">{t("flashNote")}</p>
    </div>

    <div class="stack tight">
      <h2 class="h3">{t("step2")}</h2>
      <div class="row">
        <button class="btn go" type="button" id="d-connect">{t("connect")}</button>
        <label class="swlabel" for="d-layout">{t("pinout")}</label>
        <select id="d-layout">
          {boards.map((b) => <option value={b.id} data-chip={b.chip}>{b.name}</option>)}
        </select>
        <span class="pickresult" id="d-status" role="status"></span>
      </div>
      <p class="cap left">{t("chipNote")}</p>
    </div>

    <div class="cols">
      <figure class="fig">
        <div id="d-board"></div>
        <figcaption>{t("figcaption")}</figcaption>
      </figure>
      <div class="stack">
        <div class="stack tight">
          <h2 class="h3">{t("lastTouch")}</h2>
          <p class="readout" id="d-readout" role="status">{t("nothingTouched")}</p>
          <ol class="history" id="d-history"></ol>
        </div>
        <div class="stack tight">
          <h2 class="h3">{t("quizTitle")}</h2>
          <div class="row">
            <button class="btn" type="button" id="d-quiz">{t("quizMe")}</button>
          </div>
          <p class="pickresult" id="d-quiztext" role="status"></p>
        </div>
      </div>
    </div>

    <div class="cols even band">
      <div class="stack tight">
        <h2>{t("passport")}</h2>
        <div class="tablebox" id="d-passport"></div>
        <form class="row" id="d-save" hidden>
          <input type="text" id="d-name" placeholder={t("namePlaceholder")} aria-label={t("nameAria")} maxlength="40" />
          <button class="btn" type="submit">{t("save")}</button>
        </form>
      </div>
      <div class="stack tight">
        <h2>{t("myBoards")}</h2>
        <div class="stack tight" id="d-collection"></div>
      </div>
    </div>
  </section>
</Base>

<style>
  #d-layout { padding: 7px 8px; border: 1px solid var(--line); background: var(--panel); border-radius: 2px; min-width: 0; max-width: 100%; }
</style>

<script>
  import "../../scripts/detective.ts";
</script>
