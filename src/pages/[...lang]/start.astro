---
import { localePaths } from "../../i18n/locales";
import { START } from "../../i18n/strings/pages";
import { translator } from "../../i18n/t";
import Base from "../../layouts/Base.astro";
import { localLink } from "../../lib/paths";

const link = localLink(Astro.currentLocale);
const t = translator(START, Astro.currentLocale);

const BOARDS_URL = "https://espressif.github.io/arduino-esp32/package_esp32_index.json";

export const getStaticPaths = localePaths;
---

<Base title={t("title")} current="start" description={t("description")}>
  <section class="view prose">
    <div class="stack tight">
      <h1 class="h2">{t("h1")}</h1>
      <p class="lede">{t("lede")}</p>
    </div>

    <nav class="toc" aria-label={t("toc")}>
      <a href="#need">{t("tocNeed")}</a>
      <a href="#board">{t("tocBoard")}</a>
      <a href="#plug">{t("tocPlug")}</a>
      <a href="#check">{t("tocCheck")}</a>
      <a href="#ide">{t("tocIde")}</a>
      <a href="#upload">{t("tocUpload")}</a>
      <a href="#next">{t("tocNext")}</a>
    </nav>

    <h2 id="need">{t("needH")}</h2>
    <ul>
      <li set:html={t("need1", { boards: link("/boards/") })} />
      <li set:html={t("need2")} />
      <li>{t("need3")}</li>
    </ul>

    <h2 id="board">{t("boardH")}</h2>
    <div class="tablebox">
      <table>
        <thead><tr><th>{t("thBoard")}</th><th>{t("thGood")}</th><th>{t("thWatch")}</th></tr></thead>
        <tbody>
          <tr><td>{t("classic")}</td><td>{t("classicGood")}</td><td>{t("classicWatch")}</td></tr>
          <tr><td>ESP32-S3</td><td>{t("s3Good")}</td><td>{t("s3Watch")}</td></tr>
          <tr><td>ESP32-C3</td><td>{t("c3Good")}</td><td>{t("c3Watch")}</td></tr>
          <tr><td>ESP32-S2</td><td>{t("s2Good")}</td><td>{t("s2Watch")}</td></tr>
          <tr><td>ESP32-C6</td><td>{t("c6Good")}</td><td>{t("c6Watch")}</td></tr>
          <tr><td>{t("xiao")}</td><td>{t("xiaoGood")}</td><td>{t("xiaoWatch")}</td></tr>
          <tr><td>AI-Thinker ESP32-CAM</td><td>{t("camGood")}</td><td>{t("camWatch")}</td></tr>
        </tbody>
      </table>
    </div>
    <p set:html={t("boardP", { boards: link("/boards/"), compare: link("/boards/compare/") })} />

    <h2 id="plug">{t("plugH")}</h2>
    <p>{t("plugP")}</p>
    <div class="tablebox">
      <table>
        <thead><tr><th>{t("thChip")}</th><th>{t("thDriver")}</th></tr></thead>
        <tbody>
          <tr><td class="m">CP2102, CP2104</td><td>{t("cp210x")}</td></tr>
          <tr><td class="m">CH340, CH343, CH9102</td><td>{t("ch34x")}</td></tr>
          <tr><td class="m">{t("noChip")}</td><td>{t("nativeUsb")}</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="h3">{t("linuxH")}</h3>
    <ol class="steps">
      <li set:html={t("linux1")} />
      <li>{t("linux2")}</li>
      <li set:html={t("linux3")} />
      <li set:html={t("linux4")} />
    </ol>

    <h2 id="check">{t("checkH")}</h2>
    <ol class="steps">
      <li set:html={t("check1", { bench: link("/bench/") })} />
      <li set:html={t("check2")} />
      <li set:html={t("check3")} />
    </ol>
    <p set:html={t("checkP", { detective: link("/detective/"), probe: link("/projects/probeharbor-probe/") })} />

    <h2 id="ide">{t("ideH")}</h2>
    <ol class="steps">
      <li>{t("ide1")}</li>
      <li>{t("ide2")}<br /><code class="wrapcode">{BOARDS_URL}</code></li>
      <li set:html={t("ide3")} />
      <li set:html={t("ide4")} />
      <li>{t("ide5")}</li>
    </ol>

    <h2 id="upload">{t("uploadH")}</h2>
    <ol class="steps">
      <li>{t("up1")}</li>
      <li set:html={t("up2", { blink: link("/projects/blink/") })} />
      <li set:html={t("up3")} />
      <li>{t("up4")}</li>
    </ol>

    <h2 id="next">{t("nextH")}</h2>
    <ul>
      <li set:html={t("next1", { wifi: link("/projects/wifi-scan/"), i2c: link("/projects/i2c-scan/") })} />
      <li set:html={t("next2", { library: link("/#drawer") })} />
      <li set:html={t("next3", { errors: link("/errors/") })} />
    </ul>
  </section>
</Base>
