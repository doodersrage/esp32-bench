---
import Base from "../../layouts/Base.astro";
import Pinout from "../../components/Pinout.astro";
import Flasher from "../../components/Flasher.astro";
import ProbeSetup from "../../components/ProbeSetup.astro";
import { PROJECTS, boardsOf, forBoard, type Project } from "../../data/projects";
import { boardById } from "../../data/boards";
import { link } from "../../lib/paths";
import { PROBEHARBOR, reportUrl } from "../../lib/site";
import { AFFILIATE_DISCLOSURE, shopRel, shopVendor } from "../../lib/shop";

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { id: p.id }, props: { p } }));
}

interface Props {
  p: Project;
}

const { p } = Astro.props;
const boards = boardsOf(p).map(boardById);
const panels = boards.map((board) => ({
  board,
  ...forBoard(p, board.id),
  verified: (p.verified ?? []).filter((v) => v.board === board.id),
}));
const needsLibraries = p.libs.some((l) => !/built in/.test(l));
const hasBuyLinks = p.parts.some((x) => x[2]);
const buildReportUrl = reportUrl("build", { project: p.id });
const benchHref = `${link("/bench/")}?baud=${p.baud}&sample=${p.id}`;
const boardNames = boards.map((b) => b.name).join(", ");
const summary = p.sum.length > 150 ? `${p.sum.slice(0, p.sum.lastIndexOf(" ", 147))}...` : p.sum;
const description = `${summary} Pinout, wiring and parts for the ${boardNames}.`;
---

<Base title={`${p.name}: ESP32 project`} description={description} current="library" image={`/og/projects/${p.id}.png`}>
  <section class="view">
    <a class="back" href={link("/")}>← All projects</a>

    <div class="stack tight">
      <h1 class="h2">{p.name}</h1>
      <p class="lede">{p.sum}</p>
      <div class="meta">
        <span class="tag lvl">{p.level}</span>
        <span class="tag">{p.mins} min</span>
        <span class="tag">{p.baud} baud</span>
        {p.flash && <span class="tag flash">Browser flash</span>}
      </div>
      {
        p.tags.includes("probeharbor") && (
          <p class="phcredit">
            {p.probeharbor ? "For" : "From"} <a href={PROBEHARBOR.url}>ProbeHarbor</a>, {PROBEHARBOR.blurb}.{" "}
            {
              p.probeharbor === "reads" ? (
                <>
                  This board shows readings from your ProbeHarbor sensors through a read-only share link, made under
                  Dashboard, Share at <a href={PROBEHARBOR.url}>probeharbor.dev</a>.
                </>
              ) : p.probeharbor === "sends" ? (
                <>
                  This board sends its readings to a ProbeHarbor device; create one at{" "}
                  <a href={PROBEHARBOR.url}>probeharbor.dev</a>.
                </>
              ) : (
                <>
                  This board sends its readings to a ProbeHarbor device; create one at{" "}
                  <a href={PROBEHARBOR.url}>probeharbor.dev</a>. The source is in the{" "}
                  <a href={PROBEHARBOR.repo}>ProbeHarbor repository</a>.
                </>
              )
            }
          </p>
        )
      }
    </div>

    {
      boards.length > 1 && (
        <div class="row" id="boardswitch" role="group" aria-label="Board">
          <span class="swlabel">Board</span>
          {boards.map((b, i) => (
            <button class="chip" type="button" data-board={b.id} aria-pressed={i === 0 ? "true" : "false"}>
              {b.name}
            </button>
          ))}
        </div>
      )
    }

    {
      panels.map((panel, i) => (
        <div class="stack" data-panel={panel.board.id} hidden={i !== 0}>
          <div class="cols">
            <Pinout board={panel.board} pins={panel.pins} caption={`Fig. 1. Pins this project uses on the ${panel.board.name}. USB connector at the bottom.`} />
            <div class="stack">
              <div>
                <h2 class="h3 mb">Wiring</h2>
                {panel.wiring.length > 0 ? (
                  <div class="tablebox">
                    <table>
                      <thead>
                        <tr>
                          <th>From</th>
                          <th>To board</th>
                          <th>Note</th>
                        </tr>
                      </thead>
                      <tbody>
                        {panel.wiring.map(([from, to, note]) => (
                          <tr>
                            <td>{from}</td>
                            <td class="m">{to}</td>
                            <td>{note}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  <p class="lede">Nothing to wire. This one runs on the bare board.</p>
                )}
              </div>
              <div>
                <h2 class="h3 mb">Tested on this board</h2>
                {panel.verified.length > 0 ? (
                  <ul class="checks">
                    {panel.verified.map((v) => (
                      <li>
                        <span class="tag ok">Tested</span>
                        <span>{v.what}{v.when && <span class="when">{` (${v.when})`}</span>}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="lede">Not run on this board yet. Treat the wiring and code as a first draft.</p>
                )}
              </div>
            </div>
          </div>

          {panel.code !== undefined && (
            <div class="stack tight">
              <div class="codehead">
                <h2 class="h3">Firmware, Arduino sketch for {panel.board.arduinoBoard}</h2>
                <button class="btn sm" type="button" data-copy>Copy firmware</button>
              </div>
              <pre class="code"><code>{panel.code}</code></pre>
            </div>
          )}
        </div>
      ))
    }

    {
      p.extraCode && (
        <div class="stack tight" data-code>
          <div class="codehead">
            <h2 class="h3">{p.extraCode.title}</h2>
            <button class="btn sm" type="button" data-copy>Copy sketch</button>
          </div>
          <pre class="code"><code>{p.extraCode.code}</code></pre>
        </div>
      )
    }

    <div class="cols even">
      <div>
        <h2 class="h3 mb">Parts</h2>
        <div class="tablebox">
          <table>
            <thead class="sr">
              <tr>
                <th>Quantity</th>
                <th>Part</th>
                <th>Where to buy</th>
              </tr>
            </thead>
            <tbody>
              {p.parts.map(([qty, what, href]) => (
                <tr>
                  <td class="q">{qty}×</td>
                  <td>{what}</td>
                  <td class="m">{href && <a href={href} rel={shopRel(href)} target="_blank">Buy at {shopVendor(href)}</a>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {hasBuyLinks && <p class="cap left">{AFFILIATE_DISCLOSURE}</p>}
      </div>
      {
        p.code !== undefined && (
          <div>
            <h2 class="h3 mb">Libraries</h2>
            <p>{p.libs.length > 0 ? p.libs.join(", ") : "None beyond the ESP32 Arduino core."}</p>
          </div>
        )
      }
    </div>

    {
      p.flash ? (
        <div class="stack tight">
          <h2 class="h3">Load it</h2>
          <Flasher manifest={p.flash.manifest} version={p.flash.version} />
          <ol class="steps">
            {p.flash.after.map((step) => <li>{step}</li>)}
          </ol>
          {p.setup === "probeharbor" && <ProbeSetup />}
          {p.sourceUrl && <p><a href={p.sourceUrl} rel="noopener noreferrer" target="_blank">Firmware source on GitHub</a></p>}
        </div>
      ) : (
        <div>
          <h2 class="h3 mb">Load it</h2>
          <ol class="steps">
            <li>In the Arduino IDE, install the esp32 board package and pick the board named above the sketch.</li>
            {needsLibraries && <li>Install the libraries listed above from the Library Manager.</li>}
            <li>Paste the sketch, choose the board's port and upload. Hold BOOT if the upload stalls at Connecting.</li>
            <li>Close the IDE's serial monitor, then open the bench here to watch the output.</li>
          </ol>
          {p.sourceUrl && <p><a href={p.sourceUrl} rel="noopener noreferrer" target="_blank">Sketch source on GitHub</a></p>}
        </div>
      )
    }

    {
      p.notes && (
        <div>
          <h2 class="h3 mb">Field notes</h2>
          <ul class="notes">
            {p.notes.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      )
    }

    {
      p.open && (
        <div>
          <h2 class="h3 mb">Not tested yet</h2>
          <ul class="notes">
            {p.open.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      )
    }

    <div class="row">
      <a class="btn go" href={benchHref}>Open the bench at {p.baud} baud</a>
      <button class="btn" type="button" id="built" data-project={p.id} data-board={boards[0].id} aria-pressed="false">Mark as built</button>
      <span class="pickresult" id="built-note" role="status"></span>
    </div>
    {
      buildReportUrl && (
        <p class="cap left">
          Built it? <a href={buildReportUrl}>Send a build report</a> with your board and what the serial port printed.
          Working reports become the "Tested on this board" entries above.
        </p>
      )
    }
  </section>
</Base>

<style>
  .phcredit { padding: 10px 12px; background: var(--panel); border: 1px solid var(--line); border-left: 4px solid var(--ok); font-size: 0.92rem; max-width: 75ch; }
  .phcredit a { color: var(--accent); }
</style>

<script>
  import { loadBuilt, saveBuilt } from "../../scripts/progress";

  // Board switcher: one pre-rendered panel per board, one visible at a time.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("#boardswitch [data-board]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];

  function show(board: string) {
    if (!panels.some((p) => p.dataset.panel === board)) return;
    for (const p of panels) p.hidden = p.dataset.panel !== board;
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.board === board));
  }
  for (const b of buttons) {
    b.addEventListener("click", () => {
      const board = b.dataset.board ?? "";
      show(board);
      try {
        localStorage.setItem("bench.board", board);
      } catch {
        // Remembering the board is a convenience only.
      }
    });
  }
  try {
    const saved = localStorage.getItem("bench.board");
    if (saved) show(saved);
  } catch {
    // Storage unavailable: stay on the first board.
  }

  // Build log: remember that this project worked, and on which board.
  const builtBtn = document.getElementById("built") as HTMLButtonElement;
  const builtNote = document.getElementById("built-note") as HTMLElement;
  const projectId = builtBtn.dataset.project ?? "";
  const currentBoard = () =>
    buttons.find((b) => b.getAttribute("aria-pressed") === "true")?.dataset.board ?? builtBtn.dataset.board ?? "";

  function showBuilt() {
    const mark = loadBuilt()[projectId];
    builtBtn.setAttribute("aria-pressed", String(Boolean(mark)));
    builtBtn.textContent = mark ? "Built. Undo" : "Mark as built";
    builtNote.textContent = mark ? `Logged on ${new Date(mark.at).toLocaleDateString()}. See your badges on the library page.` : "";
  }
  builtBtn.addEventListener("click", () => {
    const all = loadBuilt();
    if (all[projectId]) delete all[projectId];
    else all[projectId] = { at: new Date().toISOString(), board: currentBoard() };
    saveBuilt(all);
    showBuilt();
  });
  showBuilt();

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    btn.addEventListener("click", async () => {
      const label = btn.textContent;
      const code = btn.closest("[data-code], [data-panel]")?.querySelector("pre.code code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Copy blocked, select the text";
      }
      setTimeout(() => {
        btn.textContent = label;
      }, 1600);
    });
  }
</script>
