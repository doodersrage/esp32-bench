---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { DRAWER, PROJECTS, TAGS } from "../data/projects";
import { BADGES } from "../scripts/progress";
import { SITE } from "../lib/site";

const parts = Object.entries(DRAWER);
---

<Base
  current="library"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    description: SITE.description,
    url: Astro.site?.href,
  }}
>
  <section class="view">
    <h1 class="sr">Project library</h1>
    <p class="lede">
      Projects with a pin map, a parts list and firmware you can paste straight into the Arduino IDE. Pick one, wire
      it, then watch it talk on the bench.
    </p>
    <div class="filters">
      <input type="search" id="q" placeholder="Search projects, parts or boards" aria-label="Search projects" />
      <div class="row" id="chips">
        {
          TAGS.map(([id, label]) => (
            <button class="chip" type="button" data-tag={id} aria-pressed={id === "all" ? "true" : "false"}>
              {label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="grid" id="grid">
      {PROJECTS.map((p, i) => <ProjectCard project={p} number={i + 1} />)}
    </div>
    <div class="empty" id="empty" hidden>No project matches. Clear the search or pick another filter.</div>

    <div class="stack tight band" id="drawer">
      <h2>What can I build tonight?</h2>
      <p class="lede">Tick what is in your parts drawer. A bare board is enough for three of the projects.</p>
      <div class="row">
        {
          parts.map(([id, label]) => (
            <button class="chip" type="button" data-part={id} aria-pressed="false">
              {label}
            </button>
          ))
        }
      </div>
      <div class="row">
        <button class="btn go" type="button" id="pick">Pick a project</button>
        <span class="pickresult" id="pick-result" role="status"></span>
      </div>
    </div>

    <div class="stack tight band">
      <h2>Bench log</h2>
      <p class="lede" id="log-summary">Mark projects as built to fill this in. The log is kept in this browser only.</p>
      <ul class="badges">
        {
          BADGES.map((b) => (
            <li class="badge" data-badge={b.id}>
              <span class="badgename">{b.name}</span>
              <span class="badgehow">{b.how}</span>
              <span class="badgestate" data-badge-state>Locked</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  import "../scripts/library.ts";
</script>
