---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { DRAWER, DRAWER_GROUPS, LEVELS, PROJECTS, TAGS, bareBoard } from "../data/projects";
import { BADGES } from "../scripts/progress";
import { SITE } from "../lib/site";

// Build-time checks so the picker and the "No extra parts" filter cannot drift
// from the data as projects are added.
const grouped = DRAWER_GROUPS.flatMap(([, ids]) => ids);
const ungrouped = Object.keys(DRAWER).filter((id) => !grouped.includes(id as keyof typeof DRAWER));
const doubled = grouped.filter((id, i) => grouped.indexOf(id) !== i);
if (ungrouped.length || doubled.length) {
  throw new Error(`DRAWER_GROUPS: ungrouped ${ungrouped.join(", ") || "none"}; listed twice ${doubled.join(", ") || "none"}`);
}
const tagMismatch = PROJECTS.filter((p) => bareBoard(p) !== p.tags.includes("no-parts")).map((p) => p.id);
if (tagMismatch.length) {
  throw new Error(`The "no-parts" tag should be on exactly the projects with no needs: check ${tagMismatch.join(", ")}`);
}
const bareCount = PROJECTS.filter(bareBoard).length;
---

<Base
  current="library"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    description: SITE.description,
    url: Astro.site?.href,
    author: { "@type": "Person", name: SITE.author.name, url: SITE.author.url },
  }}
>
  <section class="view">
    <h1 class="sr">Project library</h1>
    <p class="lede">
      {PROJECTS.length} projects, each with a pin map, a parts list and firmware you can flash from the browser or paste
      into the Arduino IDE. Pick one, wire it, then watch it talk on the bench.
    </p>
    <div class="filters">
      <input type="search" id="q" placeholder="Search projects, parts or boards" aria-label="Search projects" />
      <div class="row scrollrow" id="chips">
        {
          TAGS.map(([id, label]) => (
            <button class="chip" type="button" data-tag={id} aria-pressed={id === "all" ? "true" : "false"}>
              {label}
            </button>
          ))
        }
      </div>
      <div class="row" id="levels" role="group" aria-label="Level">
        {
          LEVELS.map(([id, label]) => (
            <button class="chip sm" type="button" data-level={id} aria-pressed={id === "all" ? "true" : "false"}>
              {label}
            </button>
          ))
        }
        <a class="loglink" href="#log">Your bench log</a>
      </div>
    </div>

    <details class="drawer" id="drawer">
      <summary>What can I build tonight?</summary>
      <p class="lede">Tick what is in your parts drawer. A bare board is enough for {bareCount} of the projects.</p>
      {
        DRAWER_GROUPS.map(([label, ids]) => (
          <div class="partgroup">
            <h3 class="partlabel">{label}</h3>
            <div class="row">
              {ids.map((id) => (
                <button class="chip" type="button" data-part={id} aria-pressed="false">
                  {DRAWER[id]}
                </button>
              ))}
            </div>
          </div>
        ))
      }
      <div class="row">
        <button class="btn go" type="button" id="pick">Pick a project</button>
        <span class="pickresult" id="pick-result" role="status"></span>
      </div>
    </details>

    <div class="grid" id="grid">
      {PROJECTS.map((p, i) => <ProjectCard project={p} number={i + 1} />)}
    </div>
    <div class="empty" id="empty" hidden>No project matches. Clear the search or pick another filter.</div>

    <div class="stack tight band" id="log">
      <h2>Bench log</h2>
      <p class="lede" id="log-summary">Mark projects as built to fill this in. The log is kept in this browser only.</p>
      <ul class="badges">
        {
          BADGES.map((b) => (
            <li class="badge" data-badge={b.id}>
              <span class="badgename">{b.name}</span>
              <span class="badgehow">{b.how}</span>
              <span class="badgestate" data-badge-state>Locked</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  import "../scripts/library.ts";
</script>
