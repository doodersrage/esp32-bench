{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp32bench.dev/schema/project-manifest/v1.schema.json",
  "title": "ESP32 Bench project manifest, version 1",
  "description": "The project library the esp32bench.dev site publishes for the desktop app (/desktop-manifest.json). Version 1.x. Readers must check `format` and the major version, and ignore fields they do not know: a 1.x file may add optional fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "generated",
    "site",
    "licence",
    "boards",
    "projects"
  ],
  "properties": {
    "format": {
      "const": "esp32bench-project-manifest"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "site": {
      "type": "string"
    },
    "licence": {
      "type": "object",
      "required": [
        "code",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "SPDX id for sketch code."
        },
        "content": {
          "type": "string",
          "description": "SPDX id for written content."
        }
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "short",
          "chip",
          "arduinoBoard"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "short": {
            "type": "string"
          },
          "chip": {
            "enum": [
              "esp32",
              "esp32s2",
              "esp32s3",
              "esp32c3",
              "esp32c6"
            ]
          },
          "arduinoBoard": {
            "type": "string",
            "description": "Board name as picked in the Arduino IDE."
          },
          "variantOf": {
            "type": "string",
            "description": "Board id this one is a variant of (same chip and GPIO numbers)."
          },
          "buildAs": {
            "type": "string",
            "description": "Board id whose firmware this board runs."
          },
          "pins": {
            "type": "object",
            "additionalProperties": false,
            "description": "The board's pins (since 1.3), from the site's board data: its header, its I2C pins, the pins safe to use and those to be careful with. Pad labels that are numbers are GPIO numbers.",
            "properties": {
              "left": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "description": "Header pad labels down the left side, USB connector at the bottom. Absent when the order is not documented."
              },
              "right": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "description": "Header pad labels down the right side."
              },
              "pads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "description": "Header pad labels, for a board whose pad order is not documented (no left and right)."
              },
              "gpioOf": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "description": "GPIO numbers of pads with a name instead of a number, e.g. VP: 36."
              },
              "silk": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 8
                },
                "description": "Silkscreen names of pads labelled by GPIO number, e.g. \"2\": \"D0\"."
              },
              "i2c": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sda",
                  "scl"
                ],
                "properties": {
                  "sda": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "scl": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  }
                },
                "description": "The I2C pins to prefer."
              },
              "safe": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "description": "GPIOs with no boot, flash or USB duties, in the order to hand them out."
              },
              "special": {
                "type": "object",
                "description": "Pads that are not plain GPIOs or need care, by pad label.",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "why"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "3v3",
                        "5v",
                        "gnd",
                        "reset",
                        "flash",
                        "input-only",
                        "strap",
                        "usb",
                        "uart",
                        "caution",
                        "nc"
                      ]
                    },
                    "why": {
                      "type": "string",
                      "description": "Why, in English."
                    }
                  }
                }
              },
              "wired": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "gpio",
                    "job"
                  ],
                  "properties": {
                    "gpio": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 63
                    },
                    "job": {
                      "type": "string"
                    }
                  }
                },
                "description": "Fixed jobs some GPIOs have on this board, e.g. camera lines."
              },
              "source": {
                "type": "string",
                "description": "Where the header layout comes from (a URL)."
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "url",
          "level",
          "minutes",
          "tags",
          "summary",
          "firmware",
          "libraries",
          "baud",
          "needs",
          "parts",
          "builds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "level": {
            "enum": [
              "Starter",
              "Intermediate",
              "Advanced"
            ]
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "added": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "summary": {
            "type": "string"
          },
          "firmware": {
            "enum": [
              "sketch",
              "prebuilt"
            ]
          },
          "sourceUrl": {
            "type": "string"
          },
          "libraries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arduino libraries to install before building."
          },
          "install": {
            "type": "array",
            "description": "Libraries to download before building, in the order to install them. Libraries built into the ESP32 core are not listed. The Arduino library name is the part of `registry` after the slash.",
            "items": {
              "type": "object",
              "required": [
                "library",
                "registry"
              ],
              "additionalProperties": false,
              "properties": {
                "library": {
                  "type": "string",
                  "description": "As written in `libraries`."
                },
                "registry": {
                  "type": "string",
                  "pattern": "^[^/\\s]+/[^/]+$",
                  "description": "Registry id, owner/name, e.g. adafruit/Adafruit SSD1306."
                }
              }
            }
          },
          "partitions": {
            "enum": [
              "huge_app"
            ],
            "description": "Arduino-ESP32 partition scheme when the default app partition is too small."
          },
          "baud": {
            "type": "integer",
            "minimum": 1
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Parts beyond the board; each inner list is a set of alternatives."
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "quantity",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              }
            }
          },
          "settings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "text",
                    "password",
                    "url",
                    "number"
                  ]
                },
                "hint": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "board",
                "what"
              ],
              "additionalProperties": false,
              "properties": {
                "board": {
                  "type": "string"
                },
                "what": {
                  "type": "string"
                },
                "when": {
                  "type": "string"
                }
              }
            }
          },
          "expect": {
            "type": "object",
            "required": [
              "patterns",
              "seconds",
              "needs"
            ],
            "additionalProperties": false,
            "properties": {
              "patterns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "seconds": {
                "type": "integer",
                "minimum": 1
              },
              "needs": {
                "enum": [
                  "none",
                  "wifi",
                  "parts"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "extra": {
            "type": "object",
            "required": [
              "title",
              "board",
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "board": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          },
          "builds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "board",
                "pins",
                "wiring",
                "sample"
              ],
              "additionalProperties": false,
              "properties": {
                "board": {
                  "type": "string"
                },
                "pins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "wiring": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "from",
                      "to",
                      "note"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                },
                "code": {
                  "type": "string",
                  "description": "Arduino sketch with this board's values filled in. Absent for prebuilt firmware."
                },
                "sample": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Lines the firmware prints when it works."
                },
                "image": {
                  "type": "object",
                  "required": [
                    "url",
                    "sha256",
                    "size"
                  ],
                  "additionalProperties": false,
                  "description": "Since 1.1. For prebuilt firmware: the merged image for this board, written at offset 0, which the app downloads, checks and then runs in its simulator or flashes (asking first). An https URL on the site.",
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 33554432
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "explain": {
      "type": "array",
      "maxItems": 500,
      "description": "Since 1.1. Plain-language explanations of output lines (crashes, reset reasons, upload errors), from the same rules as the site's bench (src/lib/crash.ts) and with the error page each belongs to. The app checks simulator, serial and build output against them and says what a matching line means, once per key per run.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "pattern",
          "text",
          "level"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "pattern": {
            "type": "string",
            "description": "A regular expression in the subset JavaScript and Rust's regex crate both read: no lookaround or backreferences."
          },
          "flags": {
            "enum": [
              "i"
            ]
          },
          "text": {
            "type": "string"
          },
          "level": {
            "enum": [
              "problem",
              "info"
            ],
            "description": "problem: worth showing at once (a crash, a failed upload); info: a note (a normal reset)."
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "desktop": {
      "type": "object",
      "description": "Since 1.2. The desktop app's latest release, so an older app can say a newer one is out. The app shows it only when the version is newer than its own and the page is https.",
      "required": [
        "version",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "description": "The page to download it from."
        }
      }
    },
    "parts": {
      "type": "array",
      "description": "The site's part catalogue (since 1.3): every part projects' `needs` name, by the name projects list it under, with its pins in wiring order and the site's notes on wiring them where the site has them (else no pins).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "pins"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "name": {
            "type": "string"
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "power3",
                    "power5",
                    "gnd",
                    "in",
                    "out",
                    "bidir"
                  ]
                },
                "note": {
                  "type": "string",
                  "description": "How to wire it, in English."
                }
              }
            }
          }
        }
      }
    }
  }
}
